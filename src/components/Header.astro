---
import SiteLogo from './header/SiteLogo.astro';
import LanguageSwitcher from './header/LanguageSwitcher.astro';
import { siteTranslation } from '../config/site';

export interface Props {
  currentLang: 'id' | 'en';
  variant?: 'home' | 'page' | 'article';
  translationHref?: string;
}

const { currentLang, variant = 'page', translationHref } = Astro.props;
const homeUrl = currentLang === 'id' ? '/' : '/en/';
const t = siteTranslation[currentLang];
---

<header class="sticky top-0 z-50 bg-black border-b-4 border-white relative">
  <nav class="p-4 md:px-8 flex justify-between items-center">
    <div class="flex items-center gap-4">
      {variant === 'article' && (
        <a
          href={homeUrl}
          class="hidden md:flex text-neutral-400 hover:text-brand-cyan font-mono font-bold text-2xl border-r-2 border-neutral-700 pr-4 hover:-translate-x-1 transition-all"
          aria-label={t.backToHome}
        >
          &larr;
        </a>
      )}
      <SiteLogo currentLang={currentLang} />
    </div>

    <LanguageSwitcher currentLang={currentLang} variant={variant} translationHref={translationHref} />
  </nav>

  {variant === 'article' && (
    <div
      class="absolute bottom-[-4px] left-0 h-1 bg-brand-cyan w-0 z-50 transition-all duration-100 ease-out"
      id="reading-progress"
      role="progressbar"
      aria-label={currentLang === "id" ? "Progres membaca" : "Reading progress"}
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
    ></div>
  )}
</header>

{variant === 'article' && (
  <script is:inline>
    (() => {
      const progressBar = document.getElementById('reading-progress');
      if (!progressBar) return;

      let updatePending = false;
      const updateProgress = () => {
        const scrollTop = document.documentElement.scrollTop || document.body.scrollTop;
        const scrollableHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = scrollableHeight > 0
          ? Math.min(Math.max((scrollTop / scrollableHeight) * 100, 0), 100)
          : 0;
        const roundedProgress = Math.round(progress);

        progressBar.style.width = `${progress}%`;
        progressBar.setAttribute('aria-valuenow', String(roundedProgress));
        updatePending = false;
      };

      const scheduleUpdate = () => {
        if (updatePending) return;
        updatePending = true;
        window.requestAnimationFrame(updateProgress);
      };

      updateProgress();
      window.addEventListener('scroll', scheduleUpdate, { passive: true });
      window.addEventListener('resize', scheduleUpdate, { passive: true });
    })();
  </script>
)}
