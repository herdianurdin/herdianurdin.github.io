---
import SiteLogo from './header/SiteLogo.astro';
import LanguageSwitcher from './header/LanguageSwitcher.astro';
import { siteTranslation } from '../config/site';

export interface Props {
  currentLang: 'id' | 'en';
  variant?: 'home' | 'page' | 'article';
  translationHref?: string;
}

const { currentLang, variant = 'page', translationHref } = Astro.props;
const t = siteTranslation[currentLang];
const currentPath = Astro.url.pathname;
const journalUrl = currentLang === 'id' ? '/blog/' : '/en/blog/';
const aboutUrl = currentLang === 'id' ? '/about/' : '/en/about/';
const isJournal = /^\/(?:en\/)?blog(?:\/|$)/.test(currentPath);
const playgroundsUrl = currentLang === 'id' ? '/playgrounds/' : '/en/playgrounds/';
const isPlaygrounds = /^\/(?:en\/)?playgrounds(?:\/|$)/.test(currentPath) || currentPath === '/python-playground/';
const isAbout = currentPath === '/about/' || currentPath === '/en/about/';

const linkBase = 'inline-flex min-h-11 items-center border-2 border-transparent px-3 py-2 font-mono text-xs font-bold uppercase tracking-wide transition-colors hover:border-white hover:bg-brand-lime hover:text-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-lime';
const activeLink = 'border-white bg-white text-black shadow-neo-lime-2';
---

<header class="sticky top-0 z-50 border-b-4 border-white bg-surface-card">
  <div class="site-container flex items-center justify-between gap-2 py-3 sm:gap-3">
    <SiteLogo currentLang={currentLang} />

    <nav class="hidden items-center gap-1 md:flex" aria-label={currentLang === 'id' ? 'Navigasi utama' : 'Main navigation'}>
      <a href={journalUrl} class={`${linkBase} ${isJournal ? activeLink : 'text-neutral-300'}`} aria-current={isJournal ? 'page' : undefined}>
        {t.journalNav}
      </a>
      <a href={playgroundsUrl} class={`${linkBase} ${isPlaygrounds ? activeLink : 'text-neutral-300'}`} aria-current={isPlaygrounds ? 'page' : undefined}>
        {t.playgroundsNav}
      </a>
      <a href={aboutUrl} class={`${linkBase} ${isAbout ? activeLink : 'text-neutral-300'}`} aria-current={isAbout ? 'page' : undefined}>
        {t.aboutMe}
      </a>
    </nav>

    <div class="hidden shrink-0 items-center gap-2 md:flex md:gap-4">
      <LanguageSwitcher currentLang={currentLang} variant={variant} translationHref={translationHref} />
    </div>

    <details class="group relative md:hidden">
      <summary class="flex min-h-11 list-none cursor-pointer items-center border-2 border-white px-3 py-2 font-mono text-xs font-black uppercase text-white marker:hidden transition-colors hover:bg-brand-lime hover:text-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-lime">
        {t.menuLabel}
        <span aria-hidden="true" class="ml-2 transition-transform group-open:rotate-45">+</span>
      </summary>
      <div class="absolute right-0 top-full z-50 mt-3 w-[min(22rem,calc(100vw-2rem))] border-4 border-white bg-surface-card shadow-neo-cyan-6">
        <nav class="flex flex-col p-2" aria-label={currentLang === 'id' ? 'Navigasi utama' : 'Main navigation'}>
          <a href={journalUrl} class={`${linkBase} ${isJournal ? activeLink : 'text-neutral-300'}`} aria-current={isJournal ? 'page' : undefined}>
            {t.journalNav}
          </a>
          <a href={playgroundsUrl} class={`${linkBase} ${isPlaygrounds ? activeLink : 'text-neutral-300'}`} aria-current={isPlaygrounds ? 'page' : undefined}>
            {t.playgroundsNav}
          </a>
          <a href={aboutUrl} class={`${linkBase} ${isAbout ? activeLink : 'text-neutral-300'}`} aria-current={isAbout ? 'page' : undefined}>
            {t.aboutMe}
          </a>
        </nav>
        {(variant !== 'article' || translationHref) && (
          <div class="border-t-2 border-border-muted px-4 py-3">
            <p class="mb-2 font-mono text-[0.65rem] font-black uppercase tracking-widest text-copy-muted">
              {t.languageLabel}
            </p>
            <LanguageSwitcher currentLang={currentLang} variant={variant} translationHref={translationHref} />
          </div>
        )}
      </div>
    </details>
  </div>

  {variant === 'article' && (
    <div
      class="absolute bottom-[-4px] left-0 z-50 h-1 w-0 bg-brand-cyan transition-[width] duration-100 ease-out"
      id="reading-progress"
      role="progressbar"
      aria-label={currentLang === "id" ? "Progres membaca" : "Reading progress"}
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
    ></div>
  )}
</header>

{variant === 'article' && (
  <script is:inline>
    (() => {
      const progressBar = document.getElementById('reading-progress');
      if (!progressBar) return;

      let updatePending = false;
      const updateProgress = () => {
        const scrollTop = document.documentElement.scrollTop || document.body.scrollTop;
        const scrollableHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = scrollableHeight > 0
          ? Math.min(Math.max((scrollTop / scrollableHeight) * 100, 0), 100)
          : 0;
        progressBar.style.width = `${progress}%`;
        progressBar.setAttribute('aria-valuenow', String(Math.round(progress)));
        updatePending = false;
      };

      const scheduleUpdate = () => {
        if (updatePending) return;
        updatePending = true;
        window.requestAnimationFrame(updateProgress);
      };

      updateProgress();
      window.addEventListener('scroll', scheduleUpdate, { passive: true });
      window.addEventListener('resize', scheduleUpdate, { passive: true });
    })();
  </script>
)}
