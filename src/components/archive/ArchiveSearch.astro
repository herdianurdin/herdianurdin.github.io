---
import { siteTranslation } from "../../config/site";

export interface Props {
  language: "id" | "en";
}

const { language } = Astro.props;
const t = siteTranslation[language];
---

<section
  class="mb-8 border-4 border-white bg-surface-card p-4 shadow-neo-cyan-4 md:p-5"
  data-archive-search
  role="search"
  data-language={language}
  data-searching={t.searchLoading}
  data-too-short={t.searchTooShort}
  data-no-results={t.searchNoResults}
  data-search-error={t.searchError}
  aria-labelledby="archive-search-label"
>
  <label
    id="archive-search-label"
    for="archive-search-input"
    class="mb-2 block font-mono text-xs font-black uppercase tracking-widest text-brand-lime"
  >
    {t.searchLabel}
  </label>
  <input
    id="archive-search-input"
    type="search"
    name="q"
    autocomplete="off"
    spellcheck="false"
    placeholder={t.searchPlaceholder}
    aria-describedby="archive-search-hint archive-search-status"
    aria-controls="archive-search-results"
    class="min-h-12 w-full border-4 border-white bg-surface-page px-4 py-3 font-sans text-base text-white placeholder:text-neutral-500 focus:border-brand-lime focus:outline-none"
  />
  <p id="archive-search-hint" class="mt-2 text-sm leading-relaxed text-copy-muted">
    {t.searchHint}
  </p>
  <p
    id="archive-search-status"
    class="mt-3 min-h-5 font-mono text-xs font-bold text-brand-cyan"
    role="status"
    aria-live="polite"
  ></p>
  <ul
    id="archive-search-results"
    class="mt-4 list-none space-y-3 p-0"
    aria-label={t.searchResultsLabel}
    hidden
  ></ul>
</section>

<script>
  interface SearchEntry {
    id: string;
    language: "id" | "en";
    title: string;
    description: string;
    tags: string[];
    pubDate: string;
    url: string;
  }

  const normalize = (value: string) =>
    value
      .normalize("NFKD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLocaleLowerCase();

  document.querySelectorAll<HTMLElement>("[data-archive-search]").forEach((root) => {
    const input = root.querySelector<HTMLInputElement>("#archive-search-input");
    const status = root.querySelector<HTMLElement>("#archive-search-status");
    const resultList = root.querySelector<HTMLUListElement>("#archive-search-results");
    const archiveResults = document.querySelector<HTMLElement>("[data-archive-results]");
    const pagination = document.querySelector<HTMLElement>("[data-archive-pagination]");

    if (!input || !status || !resultList) return;

    const language = root.dataset.language;
    const messages = {
      searching: root.dataset.searching ?? "Searching...",
      tooShort: root.dataset.tooShort ?? "Enter at least 2 characters.",
      noResults: root.dataset.noResults ?? "No results found.",
      error: root.dataset.searchError ?? "Search is unavailable.",
    };

    let indexPromise: Promise<SearchEntry[]> | null = null;
    let requestSequence = 0;

    const loadIndex = () => {
      if (!indexPromise) {
        indexPromise = fetch("/search-index.json", { headers: { Accept: "application/json" } })
          .then((response) => {
            if (!response.ok) throw new Error(`Search index request failed: ${response.status}`);
            return response.json() as Promise<SearchEntry[]>;
          })
          .catch((error) => {
            indexPromise = null;
            throw error;
          });
      }
      return indexPromise;
    };

    const resetSearch = () => {
      requestSequence += 1;
      resultList.replaceChildren();
      resultList.hidden = true;
      resultList.removeAttribute("aria-busy");
      if (archiveResults) archiveResults.hidden = false;
      if (pagination) pagination.hidden = false;
      status.textContent = "";
    };

    input.addEventListener("input", async () => {
      const sequence = ++requestSequence;
      const query = normalize(input.value.trim());

      if (!query) {
        resetSearch();
        return;
      }

      resultList.replaceChildren();

      if (query.length < 2) {
        resultList.hidden = true;
        resultList.removeAttribute("aria-busy");
        if (archiveResults) archiveResults.hidden = false;
        if (pagination) pagination.hidden = false;
        status.textContent = messages.tooShort;
        return;
      }

      if (archiveResults) archiveResults.hidden = true;
      if (pagination) pagination.hidden = true;
      resultList.hidden = false;
      resultList.setAttribute("aria-busy", "true");
      status.textContent = messages.searching;

      try {
        const index = await loadIndex();
        if (sequence !== requestSequence) return;

        const matches = index
          .filter((entry) => entry.language === language)
          .filter((entry) => {
            const searchable = normalize([
              entry.title,
              entry.description,
              ...(entry.tags ?? []),
            ].join(" "));
            return searchable.includes(query);
          });

        if (matches.length === 0) {
          resultList.removeAttribute("aria-busy");
          status.textContent = messages.noResults;
          return;
        }

        const fragment = document.createDocumentFragment();
        for (const entry of matches.slice(0, 12)) {
          const item = document.createElement("li");
          item.className = "border-2 border-white bg-surface-page p-4";

          const link = document.createElement("a");
          link.href = entry.url;
          link.textContent = entry.title;
          link.className = "font-black text-white underline decoration-brand-lime decoration-2 underline-offset-4 hover:text-brand-cyan focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-lime";

          const summary = document.createElement("p");
          summary.textContent = entry.description;
          summary.className = "mt-2 text-sm leading-relaxed text-neutral-300";

          const meta = document.createElement("p");
          const formattedDate = new Date(entry.pubDate).toLocaleDateString(
            language === "id" ? "id-ID" : "en-US",
            { year: "numeric", month: "short", day: "numeric" },
          );
          const tagLabel = (entry.tags ?? []).join(" · ");
          meta.textContent = [formattedDate, tagLabel].filter(Boolean).join(" · ");
          meta.className = "mt-3 font-mono text-xs font-bold uppercase tracking-wide text-brand-cyan";

          item.append(link, summary, meta);
          fragment.append(item);
        }

        resultList.replaceChildren(fragment);
        resultList.removeAttribute("aria-busy");
        status.textContent = `${matches.length} ${language === "id" ? "artikel ditemukan" : "articles found"}${matches.length > 12 ? ` · ${language === "id" ? "menampilkan 12 teratas" : "showing top 12"}` : ""}.`;
      } catch {
        if (sequence !== requestSequence) return;
        resultList.hidden = true;
        resultList.removeAttribute("aria-busy");
        if (archiveResults) archiveResults.hidden = false;
        if (pagination) pagination.hidden = false;
        status.textContent = messages.error;
      }
    });
  });
</script>
