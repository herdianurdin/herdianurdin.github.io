---
import type { CollectionEntry } from "astro:content";
import type { Page } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../ui/ArticleCard.astro";
import { siteTranslation } from "../../config/site";

type ArchiveCollectionPage =
  | Page<CollectionEntry<"id">>
  | Page<CollectionEntry<"en">>;

export interface Props {
  page: ArchiveCollectionPage;
  language: "id" | "en";
}

const { page, language } = Astro.props;
const t = siteTranslation[language];
---

<BaseLayout
  title={`${t.archiveTitle} - ${t.pageText} ${page.currentPage}`}
  description={t.archiveDesc}
  language={language}
  headerVariant="page"
  noindex={true}
>
  <main id="main-content" tabindex="-1" class="max-w-5xl mx-auto p-6 md:p-12 w-full flex-grow">
    <header class="mb-12">
      <h1
        class="text-4xl md:text-5xl font-black uppercase tracking-tight border-l-8 border-brand-lime pl-6"
      >
        {t.archiveTitle}
      </h1>
      {
        page.data.length > 0 && (
          <p class="font-mono text-neutral-400 mt-4">
            {t.pageText}
            {page.currentPage}
            {t.ofText}
            {page.lastPage}
          </p>
        )
      }
    </header>

    {
      page.data.length > 0 ? (
        <>
          <div class="grid md:grid-cols-2 gap-8 mb-16">
            {page.data.map((post) => (
              <ArticleCard post={post} language={language} />
            ))}
          </div>

          <nav
            class="flex justify-between items-center border-t-4 border-white pt-8 font-mono font-bold text-sm md:text-base"
            aria-label={language === "id" ? "Navigasi halaman" : "Page navigation"}
          >
            {page.url.prev ? (
              <a
                href={page.url.prev}
                aria-label={t.ariaPrev}
                class="bg-white text-black px-4 md:px-6 py-2 md:py-3 border-4 border-white shadow-neo-cyan-4 hover:bg-brand-cyan hover:border-black active:translate-y-1 active:translate-x-1 active:shadow-none transition-all"
              >
                &larr; {t.prevPage}
              </a>
            ) : (
              <span class="px-4 md:px-6 py-2 md:py-3 border-4 border-neutral-700 text-neutral-600 cursor-not-allowed bg-neutral-900">
                &larr; {t.prevPage}
              </span>
            )}

            <span class="text-neutral-400 text-xs md:text-sm" aria-current="page">
              {t.shortPageText}
              {page.currentPage}
            </span>

            {page.url.next ? (
              <a
                href={page.url.next}
                aria-label={t.ariaNext}
                class="bg-white text-black px-4 md:px-6 py-2 md:py-3 border-4 border-white shadow-neo-cyan-4 hover:bg-brand-cyan hover:border-black active:translate-y-1 active:translate-x-1 active:shadow-none transition-all"
              >
                {t.nextPage} &rarr;
              </a>
            ) : (
              <span class="px-4 md:px-6 py-2 md:py-3 border-4 border-neutral-700 text-neutral-600 cursor-not-allowed bg-neutral-900">
                {t.nextPage} &rarr;
              </span>
            )}
          </nav>
        </>
      ) : (
        <div class="border-4 border-white bg-black p-10 md:p-16 text-center shadow-neo-lime-12 mb-16 mt-12">
          <span class="text-6xl mb-6 block">🚧</span>
          <h1 class="text-3xl md:text-4xl font-black uppercase text-white mb-4">
            {t.emptyArchiveTitle}
          </h1>
          <p class="font-mono text-neutral-400 text-lg">
            {t.emptyArchiveMessage}
          </p>
        </div>
      )
    }
  </main>
</BaseLayout>
