---
import type { CollectionEntry } from "astro:content";
import type { Page } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../ui/ArticleCard.astro";
import ArchiveSearch from "./ArchiveSearch.astro";
import { siteTranslation } from "../../config/site";

type ArchiveCollectionPage =
  | Page<CollectionEntry<"id">>
  | Page<CollectionEntry<"en">>;

export interface Props {
  page: ArchiveCollectionPage;
  language: "id" | "en";
}

const { page, language } = Astro.props;
const t = siteTranslation[language];
---

<BaseLayout
  title={`${t.archiveTitle} - ${t.pageText} ${page.currentPage}`}
  description={t.archiveDesc}
  language={language}
  headerVariant="page"
  noindex={true}
>
  <main id="main-content" tabindex="-1" class="site-container page-main page-main--archive">
    <header class="mb-12">
      <p class="mb-3 font-mono text-xs font-black uppercase tracking-widest text-brand-cyan">
        {language === "id" ? "JELAJAHI SEMUA ARTIKEL" : "EXPLORE ALL ARTICLES"}
      </p>
      <h1
        class="border-l-8 border-brand-lime pl-5 text-4xl font-black uppercase tracking-tight md:pl-6 md:text-5xl"
      >
        {t.archiveTitle}
      </h1>
      <p class="mt-4 max-w-2xl leading-relaxed text-neutral-300">{t.archiveDesc}</p>
      {
        page.data.length > 0 && (
          <p class="mt-4 font-mono text-xs font-bold uppercase tracking-wide text-copy-muted">
            {t.pageText} {page.currentPage} {t.ofText} {page.lastPage}
          </p>
        )
      }
    </header>

    {
      page.data.length > 0 ? (
        <>
          <ArchiveSearch language={language} />
          <div data-archive-results class="mb-16 grid gap-6 md:grid-cols-2 md:gap-8">
            {page.data.map((post) => (
              <ArticleCard post={post} language={language} />
            ))}
          </div>

          <nav
            data-archive-pagination
            class="flex justify-between items-center border-t-4 border-white pt-8 font-mono font-bold text-sm md:text-base"
            aria-label={language === "id" ? "Navigasi halaman" : "Page navigation"}
          >
            {page.url.prev ? (
              <a
                href={page.url.prev}
                aria-label={t.ariaPrev}
                class="bg-white text-black px-4 md:px-6 py-2 md:py-3 border-4 border-white shadow-neo-cyan-4 hover:bg-brand-cyan hover:border-black active:translate-y-1 active:translate-x-1 active:shadow-none transition-all"
              >
                &larr; {t.prevPage}
              </a>
            ) : (
              <span class="px-4 md:px-6 py-2 md:py-3 border-4 border-neutral-700 text-neutral-600 cursor-not-allowed bg-surface-page">
                &larr; {t.prevPage}
              </span>
            )}

            <span class="text-copy-muted text-xs md:text-sm" aria-current="page">
              {t.shortPageText}
              {page.currentPage}
            </span>

            {page.url.next ? (
              <a
                href={page.url.next}
                aria-label={t.ariaNext}
                class="bg-white text-black px-4 md:px-6 py-2 md:py-3 border-4 border-white shadow-neo-cyan-4 hover:bg-brand-cyan hover:border-black active:translate-y-1 active:translate-x-1 active:shadow-none transition-all"
              >
                {t.nextPage} &rarr;
              </a>
            ) : (
              <span class="px-4 md:px-6 py-2 md:py-3 border-4 border-neutral-700 text-neutral-600 cursor-not-allowed bg-surface-page">
                {t.nextPage} &rarr;
              </span>
            )}
          </nav>
        </>
      ) : (
        <div class="border-4 border-white bg-surface-card p-10 md:p-16 text-center shadow-neo-lime-12 mb-16 mt-12">
          <span class="text-6xl mb-6 block">🚧</span>
          <h2 class="mb-4 text-3xl font-black uppercase text-white md:text-4xl">
            {t.emptyArchiveTitle}
          </h2>
          <p class="font-mono text-copy-muted text-lg">
            {t.emptyArchiveMessage}
          </p>
        </div>
      )
    }
  </main>
</BaseLayout>
