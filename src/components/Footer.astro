---
// src/components/Footer.astro
import { siteConfig, siteTranslation } from "../config/site";

// Menambahkan opsi properti bahasa dengan nilai bawaan 'id' agar tidak memicu galat
// jika ada layout lama yang belum mengirimkan properti ini.
export interface Props {
  language?: "id" | "en";
}
const { language = "id" } = Astro.props;

const t = siteTranslation[language as keyof typeof siteTranslation];
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto w-full border-t-4 border-white bg-surface-card">
  <div class="site-container flex flex-col items-center justify-between gap-4 py-8 md:flex-row">
    <p class="font-mono text-copy-muted text-sm text-center md:text-left">
      &copy; {currentYear}
      {siteConfig.author}.
    </p>

    {/* Menambahkan flex-wrap agar rapi di layar HP */}
    <div
      class="flex flex-wrap justify-center gap-4 text-sm font-mono text-copy-muted"
    >
      <a
        href={language == "id" ? "/about/" : "/en/about/"}
        class="inline-flex min-h-6 items-center hover:text-brand-lime hover:underline underline-offset-4 decoration-2 transition-colors"
      >
        {t.aboutMe}
      </a>

      <a
        href={language == "id" ? "/privacy-policy/" : "/en/privacy-policy/"}
        aria-label={`${t.privacyPolicy} ${siteConfig.author}`}
        class="inline-flex min-h-6 items-center hover:text-brand-lime hover:underline underline-offset-4 decoration-2 transition-colors"
      >
        {t.privacyPolicy}
      </a>

      <a
        href={language == "id" ? "/disclaimer/" : "/en/disclaimer/"}
        class="inline-flex min-h-6 items-center hover:text-brand-lime hover:underline underline-offset-4 decoration-2 transition-colors"
      >
        {t.disclaimer}
      </a>

      <a
        href={language == "id" ? "/terms-of-service/" : "/en/terms-of-service/"}
        class="inline-flex min-h-6 items-center hover:text-brand-lime hover:underline underline-offset-4 decoration-2 transition-colors"
      >
        {t.termsOfService}
      </a>

      <a
        href={language == "id" ? "/editorial-policy/" : "/en/editorial-policy/"}
        class="inline-flex min-h-6 items-center hover:text-brand-lime hover:underline underline-offset-4 decoration-2 transition-colors"
      >
        {t.editorialPolicy}
      </a>
    </div>
  </div>
</footer>
