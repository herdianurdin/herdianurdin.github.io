---
export interface Props {
  id?: string;
}
const { id = "code-editor" } = Astro.props;
---

<div
  class="flex flex-col border-4 border-white shadow-neo-cyan-8 relative h-full flex-1 min-w-0 bg-editor"
>
  <div
    class="bg-surface-card flex border-b-4 border-white z-10 shrink-0 w-full justify-between overflow-hidden"
  >
    <div class="flex overflow-x-auto no-scrollbar min-w-0">
      <div
        id="tabs-container"
        class="flex"
        role="group"
        aria-label="Daftar file Python"
      ></div>

      <button
        id="add-tab-btn"
        type="button"
        aria-label="Tambah modul Python baru"
        title="Tambah Modul Baru"
        class="px-4 py-2 bg-editor-panel text-white font-black border-r-4 border-white hover:bg-brand-cyan hover:text-black transition-colors shrink-0"
      >
        +
      </button>
    </div>

    <button
      id="run-btn"
      type="button"
      aria-controls="output-terminal"
      class="px-6 py-2 bg-brand-lime text-black font-black uppercase hover:bg-white transition-colors flex items-center justify-center gap-2 cursor-pointer border-l-4 border-white shrink-0"
    >
      <svg
        class="w-5 h-5 hidden sm:block"
        fill="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg
      >
      <span id="run-text" aria-live="polite" aria-atomic="true">JALANKAN</span>
    </button>
  </div>

  <div class="flex-1 w-full relative overflow-hidden">
    <textarea id={id} style="display: none;" aria-label="Editor kode Python"></textarea>
  </div>
</div>
