---
// src/components/playground/CodeEditor.astro
export interface Props {
  id?: string;
}
const { id = "code-editor" } = Astro.props;
---

<!-- Menambahkan border dan shadow-[8px_8px_0px_0px_#00e5ff] khas blog Anda -->
<div
  class="flex flex-col border-4 border-white shadow-[8px_8px_0px_0px_#00e5ff] relative h-full flex-1 min-w-0 bg-[#282a36]"
>
  <!-- Header Editor: Tab Modul Kiri & Tombol RUN di Kanan -->
  <div
    class="bg-black flex border-b-4 border-white z-10 shrink-0 w-full justify-between overflow-hidden"
  >
    <div class="flex overflow-x-auto no-scrollbar">
      <div id="tabs-container" class="flex">
        <!-- Tab di-render oleh JS -->
      </div>

      <!-- Tombol Tambah File dengan efek hover cyan -->
      <button
        id="add-tab-btn"
        class="px-4 py-2 bg-[#1e1e1e] text-white font-black border-r-4 border-white hover:bg-[#00e5ff] hover:text-black transition-colors shrink-0"
        title="Tambah Modul Baru"
      >
        +
      </button>
    </div>

    <!-- Tombol RUN -->
    <button
      id="run-btn"
      class="px-6 py-2 bg-[#c6ff00] text-black font-black uppercase hover:bg-white transition-colors flex items-center justify-center gap-2 cursor-pointer border-l-4 border-white shrink-0"
    >
      <svg
        class="w-5 h-5 hidden sm:block"
        fill="currentColor"
        viewBox="0 0 24 24"><path d="M8 5v14l11-7z"></path></svg
      >
      <span id="run-text">JALANKAN</span>
    </button>
  </div>

  <div class="flex-1 w-full relative overflow-hidden">
    <textarea id={id} style="display: none;"></textarea>
  </div>
</div>
