---
// src/components/playground/Toolbar.astro
---

<div
  class="flex flex-col sm:flex-row justify-between items-center p-4 border-b-4 border-white bg-neutral-800 gap-4 shrink-0"
>
  <button
    id="run-btn"
    class="w-full sm:w-auto px-8 py-3 bg-[#c6ff00] text-black font-black text-xl border-4 border-white shadow-[4px_4px_0px_0px_#ffffff] hover:translate-y-1 hover:shadow-[1px_1px_0px_0px_#ffffff] active:translate-y-2 active:shadow-none transition-all flex items-center justify-center gap-2 uppercase cursor-pointer"
  >
    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"
      ><path d="M8 5v14l11-7z"></path></svg
    >
    <span id="run-text">Run Code</span>
  </button>

  <div
    class="font-mono text-sm px-4 py-2 border-2 border-white bg-black flex items-center gap-2"
  >
    <span
      id="status-indicator"
      class="w-3 h-3 rounded-full bg-yellow-500 animate-pulse"></span>
    <span
      id="status-text"
      class="text-white uppercase font-bold tracking-widest"
      >Idle (Menunggu)</span
    >
  </div>
</div>
