---
// src/components/playground/Terminal.astro
export interface Props {
  id?: string;
}
const { id = "output-terminal" } = Astro.props;
---

<!-- Menambahkan border dan shadow-[8px_8px_0px_0px_#c6ff00] -->
<div
  class="flex flex-col border-4 border-white shadow-[8px_8px_0px_0px_#c6ff00] bg-black h-full flex-1 min-w-0"
>
  <div
    class="bg-white text-black font-black px-4 py-2 border-b-4 border-white uppercase flex justify-between items-center shrink-0"
  >
    <span>Terminal</span>
    <!-- Ornamen titik ala MacOS untuk estetika Neo-Brutalism -->
    <div class="flex gap-2">
      <span class="w-3 h-3 rounded-full border-2 border-black bg-[#00e5ff]"
      ></span>
      <span class="w-3 h-3 rounded-full border-2 border-black bg-[#c6ff00]"
      ></span>
    </div>
  </div>

  <div class="flex-1 p-4 overflow-y-auto relative" id="terminal-container">
    <pre
      id={id}
      class="w-full text-[#c6ff00] font-mono whitespace-pre-wrap leading-relaxed text-sm md:text-base selection:bg-white selection:text-black m-0 pb-8">
    </pre>
  </div>
</div>
