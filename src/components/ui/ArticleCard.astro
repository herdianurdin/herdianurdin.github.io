---
import type { CollectionEntry } from "astro:content";
import { siteTranslation } from "../../config/site";

export interface Props {
  post: CollectionEntry<"id"> | CollectionEntry<"en">;
  language: "id" | "en";
}

const { post, language } = Astro.props;
const siteConfigs = siteTranslation[language];
const postUrl = language === "id"
  ? `/blog/${post.id}/`
  : `/en/blog/${post.id}/`;

const dateOptions: Intl.DateTimeFormatOptions = {
  year: "numeric",
  month: "long",
  day: "numeric",
};
const formattedDate = post.data.pubDate.toLocaleDateString(
  language === "id" ? "id" : "en",
  dateOptions,
);
---

<article
  class="border-4 border-white bg-black flex flex-col h-full hover:-translate-y-2 hover:shadow-neo-lime-8 transition-all duration-300"
>
  {
    post.data.coverImage && (
      <a
        href={postUrl}
        class="block border-b-4 border-white overflow-hidden group"
        aria-hidden="true"
        tabindex="-1"
      >
        <img
          src={post.data.coverImage}
          alt=""
          width="1200"
          height="630"
          loading="lazy"
          decoding="async"
          class="w-full aspect-[1200/630] object-cover grayscale group-hover:grayscale-0 transition-all duration-500 bg-neutral-900 border-b-4 border-white"
          onerror="this.removeAttribute('onerror'); this.setAttribute('src', 'https://placehold.co/1200x630/000000/c6ff00.png?text=Gambar+Tidak+Tersedia');"
        />
      </a>
    )
  }

  <div class="p-6 flex flex-col flex-grow">
    <div class="flex flex-wrap gap-2 mb-4">
      {
        post.data.tags?.slice(0, 2).map((tag: string) => (
          <span class="bg-white text-black text-xs font-bold px-2 py-1 uppercase border-2 border-black shadow-neo-fuchsia-2">
            {tag}
          </span>
        ))
      }
    </div>

    <a href={postUrl} class="group mb-2" data-astro-prefetch="hover">
      <h3
        class="text-2xl font-black text-white leading-tight group-hover:text-brand-cyan transition-colors"
      >
        {post.data.title}
      </h3>
    </a>

    <time
      datetime={post.data.pubDate.toISOString()}
      class="text-neutral-400 text-sm mb-4 font-mono block"
    >
      {formattedDate}
    </time>

    <p class="text-neutral-300 line-clamp-3 mb-6 flex-grow leading-relaxed">
      {post.data.description}
    </p>

    <a
      href={postUrl}
      class="inline-block mt-auto text-brand-lime font-mono font-bold uppercase hover:underline w-fit"
      aria-label={`${language === "id" ? "Baca artikel lengkap tentang" : "Read full article about"} ${post.data.title}`}
      data-astro-prefetch="hover"
    >
      {siteConfigs.readArticle}
    </a>
  </div>
</article>
