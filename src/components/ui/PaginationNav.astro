---
// src/components/ui/PaginationNav.astro
import type { Page } from "astro";

export interface Props {
  // Objek 'page' ini dihasilkan otomatis oleh fungsi paginate() di Astro
  page: Page<any>;
  language: "id" | "en";
}

const { page, language } = Astro.props;

// Teks dinamis berdasarkan bahasa
const prevText = language === "id" ? "← Sebelumnya" : "← Previous";
const nextText = language === "id" ? "Selanjutnya →" : "Next →";
---

<nav
  class="flex flex-wrap justify-between items-center gap-4 mt-16 mb-8 font-mono font-bold"
  aria-label="Navigasi Halaman"
>
  {/* Tombol Sebelumnya */}
  {
    page.url.prev ? (
      <a
        href={page.url.prev}
        class="bg-white text-black border-4 border-black px-4 md:px-6 py-2 shadow-neo-fuchsia-4 hover:shadow-neo-lime-6 hover:-translate-y-1 transition-all"
        data-astro-prefetch="hover"
      >
        {prevText}
      </a>
    ) : (
      <span class="px-4 md:px-6 py-2 text-neutral-500 border-4 border-neutral-700 bg-surface-page cursor-not-allowed">
        {prevText}
      </span>
    )
  }

  {/* Indikator Nomor Halaman */}
  <span
    class="text-white bg-surface-card border-4 border-white px-4 py-2 shadow-neo-cyan-4"
  >
    {page.currentPage} / {page.lastPage}
  </span>

  {/* Tombol Selanjutnya */}
  {
    page.url.next ? (
      <a
        href={page.url.next}
        class="bg-brand-lime text-black border-4 border-black px-4 md:px-6 py-2 shadow-neo-fuchsia-4 hover:shadow-neo-cyan-6 hover:-translate-y-1 transition-all"
        data-astro-prefetch="hover"
      >
        {nextText}
      </a>
    ) : (
      <span class="px-4 md:px-6 py-2 text-neutral-500 border-4 border-neutral-700 bg-surface-page cursor-not-allowed">
        {nextText}
      </span>
    )
  }
</nav>
