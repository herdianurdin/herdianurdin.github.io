---
import { siteTranslation } from "../../config/site";

export interface Props {
  language: "id" | "en";
}

const { language } = Astro.props;
const t = siteTranslation[language];
const journalUrl = language === "id" ? "/blog/" : "/en/blog/";
const playgroundsUrl = language === "id" ? "/playgrounds/" : "/en/playgrounds/";
---

<section
  class="editorial-hero relative isolate mb-16 mt-8 overflow-hidden border-4 border-white bg-surface-card p-6 shadow-neo-lime-8 md:p-10"
  aria-labelledby="editorial-hero-heading"
>
  <div class="editorial-hero__art" aria-hidden="true"></div>

  <div class="editorial-hero__content">
    <div
      class="mb-5 inline-flex border-2 border-black bg-brand-cyan px-3 py-1 font-mono text-xs font-black uppercase tracking-wider text-black shadow-neo-paper-2"
    >
      {language === "id" ? "JURNAL TEKNOLOGI & PEMROGRAMAN" : "TECHNOLOGY & PROGRAMMING JOURNAL"}
    </div>

    <h1
      id="editorial-hero-heading"
      class="mb-5 max-w-4xl text-4xl font-black leading-[1.08] tracking-tight text-white md:text-6xl"
    >
      {t.editorialHeading}
    </h1>

    <p class="mb-8 max-w-2xl text-base leading-relaxed text-neutral-300 md:text-lg">
      {t.editorialIntro}
    </p>

    <div class="flex flex-col gap-4 sm:flex-row sm:flex-wrap">
      <a
        href={journalUrl}
        class="inline-flex min-h-12 items-center justify-center border-4 border-white bg-brand-lime px-6 py-3 text-center font-mono text-sm font-black uppercase text-black shadow-neo-paper-4 transition-transform hover:-translate-y-1 hover:shadow-neo-cyan-6 focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-brand-lime active:translate-x-1 active:translate-y-1 active:shadow-none"
      >
        {t.browseJournal} <span aria-hidden="true" class="ml-2">→</span>
      </a>
      <a
        href={playgroundsUrl}
        class="inline-flex min-h-12 items-center justify-center border-4 border-white bg-surface-page px-6 py-3 text-center font-mono text-sm font-black uppercase text-white shadow-neo-cyan-4 transition-colors hover:bg-brand-cyan hover:text-black focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-brand-lime active:translate-x-1 active:translate-y-1 active:shadow-none"
      >
        {t.browsePlaygrounds}
      </a>
    </div>
  </div>
</section>

<style>
  .editorial-hero__art {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: url("/assets/graphics/editorial-hero-blueprint.svg");
    background-repeat: no-repeat;
    background-position: right 1.5rem center;
    background-size: min(44%, 29rem) auto;
    opacity: 0.42;
  }

  .editorial-hero__content {
    position: relative;
    z-index: 1;
    max-width: 64rem;
  }

  @media (max-width: 767px) {
    .editorial-hero__art {
      background-position: right -2.25rem bottom -1.5rem;
      background-size: 12rem auto;
      opacity: 0.2;
    }
  }
</style>
