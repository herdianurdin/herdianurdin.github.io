---
import { Image } from "astro:assets";
import { siteConfig, siteTranslation } from "../../config/site";
import SocialLinks from "../author/SocialLinks.astro";

export interface Props {
  language: "id" | "en";
}

const { language } = Astro.props;
const t = siteTranslation[language];
const profileUrl = language === "id" ? "/about/" : "/en/about/";
---

<section
  class="mb-16 mt-16 flex flex-col overflow-hidden border-4 border-white bg-surface-panel shadow-neo-fuchsia-8 md:flex-row"
  aria-labelledby="author-intro-heading"
>
  <div
    class="flex items-center justify-center border-b-4 border-white bg-surface-card p-4 md:w-[34%] md:max-w-[22rem] md:shrink-0 md:border-b-0 md:border-r-4 md:p-0"
  >
    <Image
      src={siteConfig.profileImage}
      format="webp"
      widths={[128, 256, 384, 512]}
      sizes="(max-width: 768px) 16rem, 22rem"
      quality={80}
      alt={siteConfig.author}
      class="aspect-square w-full max-w-[16rem] object-contain md:max-w-none"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="flex min-w-0 flex-1 flex-col p-6 md:p-8">
    <p class="mb-3 font-mono text-xs font-black uppercase tracking-widest text-brand-fuchsia-readable">
      {language === "id" ? "TENTANG PENULIS" : "ABOUT THE AUTHOR"}
    </p>
    <h2 id="author-intro-heading" class="mb-2 text-3xl font-black tracking-tight text-white md:text-4xl">
      {siteConfig.author}
    </h2>
    <p class="mb-5 font-mono text-sm font-bold text-brand-lime">{t.heroTitle}</p>
    <p class="mb-7 max-w-2xl leading-relaxed text-neutral-300">{t.heroBio}</p>

    <div class="mt-auto flex flex-wrap gap-3 border-t-2 border-border-muted pt-6">
      <a
        href={profileUrl}
        class="inline-flex min-h-11 items-center border-2 border-white bg-white px-5 py-2 font-mono text-sm font-black text-black shadow-neo-lime-4 transition-transform hover:-translate-y-1 hover:shadow-neo-cyan-6 focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-brand-lime active:translate-x-1 active:translate-y-1 active:shadow-none"
      >
        {t.profileBtn}
      </a>
      <a
        href={siteConfig.github}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 items-center border-2 border-white bg-surface-card px-5 py-2 font-mono text-sm font-bold text-white transition-colors hover:bg-brand-cyan hover:text-black focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-brand-lime"
      >
        GitHub <span aria-hidden="true" class="ml-2">↗</span>
      </a>
    </div>

    <div class="mt-5">
      <p class="mb-3 font-mono text-[0.68rem] font-black uppercase tracking-widest text-copy-muted">
        {language === "id" ? "MEDIA SOSIAL" : "SOCIAL MEDIA"}
      </p>
      <SocialLinks language={language} />
    </div>
  </div>
</section>
