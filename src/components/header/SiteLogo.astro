---
import { siteConfig } from "../../config/site";

export interface Props {
  currentLang: "id" | "en";
}
const { currentLang } = Astro.props;
const homeUrl = currentLang === "id" ? "/" : "/en/";
---

<div class="font-black text-xl md:text-2xl tracking-tighter uppercase">
  <a href={homeUrl} class="hover:text-brand-lime transition-colors">
    {siteConfig.logoText}<span class="text-brand-lime">{siteConfig.logoHighlight}</span>
  </a>
</div>
