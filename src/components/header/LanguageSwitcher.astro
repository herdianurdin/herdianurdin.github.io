---
import { siteTranslation } from "../../config/site";

export interface Props {
  currentLang: "id" | "en";
  variant?: "home" | "page" | "article";
  translationHref?: string;
}

const { currentLang, variant, translationHref } = Astro.props;
const t = siteTranslation[currentLang];
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const withTrailingSlash = (path: string) =>
  path === "/" ? "/" : `${path.replace(/\/+$/, "")}/`;
const isArchivePath = /^\/(?:en\/)?blog(?:\/\d+)?$/.test(currentPath);
const idHref = currentLang === "en"
  ? (isArchivePath ? "/blog/" : withTrailingSlash(currentPath.replace(/^\/en(?=\/|$)/, "") || "/"))
  : withTrailingSlash(currentPath);
const enHref = currentLang === "id"
  ? (isArchivePath ? "/en/blog/" : currentPath === "/" ? "/en/" : `/en${currentPath}/`)
  : withTrailingSlash(currentPath);

const idBtnClass = currentLang === "id"
  ? "inline-flex min-h-10 items-center bg-white text-black font-bold border-2 border-white px-3 py-2 shadow-neo-lime-2"
  : "inline-flex min-h-10 items-center hover:bg-brand-lime hover:text-black border-2 border-transparent hover:border-white px-3 py-2 transition-colors";

const enBtnClass = currentLang === "en"
  ? "inline-flex min-h-10 items-center bg-white text-black font-bold border-2 border-white px-3 py-2 shadow-neo-lime-2"
  : "inline-flex min-h-10 items-center hover:bg-brand-lime hover:text-black border-2 border-transparent hover:border-white px-3 py-2 transition-colors";
---

{
  variant === "article"
    ? translationHref && (
        <div class="flex gap-1 font-mono text-xs sm:gap-2 sm:text-sm">
          <a
            href={translationHref}
            class="inline-flex min-h-10 items-center hover:bg-brand-lime hover:text-black border-2 border-transparent hover:border-white px-2 py-2 transition-colors sm:px-3"
            aria-label={currentLang === "id" ? t.switchEn : t.switchId}
          >
            {currentLang === "id" ? "/EN" : "/ID"}
          </a>
        </div>
      )
    : (
        <div class="flex gap-1 font-mono text-xs sm:gap-2 sm:text-sm">
          <a
            href={idHref}
            class={idBtnClass}
            aria-label={t.switchId}
            aria-current={currentLang === "id" ? "page" : undefined}
          >
            /ID
          </a>
          <a
            href={enHref}
            class={enBtnClass}
            aria-label={t.switchEn}
            aria-current={currentLang === "en" ? "page" : undefined}
          >
            /EN
          </a>
        </div>
      )
}
