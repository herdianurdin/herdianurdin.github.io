---
import { siteConfig, siteTranslation } from "../config/site";

export interface Props {
  title: string;
  description: string;
  image?: string;
  isArticle?: boolean;
  language: "id" | "en";
  enSlug?: string;
  idSlug?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image = "/images/og-default.webp",
  isArticle = false,
  language,
  enSlug,
  idSlug,
  noindex = false
} = Astro.props;

const t = siteTranslation[language as keyof typeof siteTranslation];
const domainName = siteConfig.url.replace(/^https?:\/\//, "");

// URL Halaman Saat Ini
const currentPath = Astro.url.pathname.replace(/\/$/, "");
const canonicalURL = new URL(currentPath === "" ? "/" : currentPath, Astro.site);

// LOGIKA HREFLANG PINTAR
let alternatePath = "";
let hasAlternate = false;

if (isArticle) {
  // Jika ini artikel, KITA HANYA membuat Hreflang alternatif JIKA slug pasangannya diisi di Frontmatter
  if (language === "id" && enSlug) {
    alternatePath = `/en/blog/${enSlug}`;
    hasAlternate = true;
  } else if (language === "en" && idSlug) {
    alternatePath = `/blog/${idSlug}`;
    hasAlternate = true;
  }
  // Jika artikel tidak punya pasangan terjemahan, hasAlternate tetap false
} else {
  // Jika ini halaman statis (Home, About, Playground), lakukan penggantian rute standar
  hasAlternate = true;
  const rawPath = language === "id"
    ? `/en${Astro.url.pathname}`
    : Astro.url.pathname.replace(/^\/en/, "");
  alternatePath = rawPath === "" ? "/" : rawPath;
}

const alternateLang = language === "id" ? "en" : "id";
const alternateURL = hasAlternate ? new URL(alternatePath, Astro.site) : null;

// x-default mengarah ke versi EN jika ada, jika tidak, kembali ke halaman saat ini
const xDefaultURL = (language === "en" || (language === "id" && hasAlternate)) 
  ? (language === "en" ? canonicalURL : alternateURL)
  : canonicalURL;

// --- SCHEMA & LAINNYA ---
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: siteConfig.author,
  jobTitle: t.heroTitle,
  url: siteConfig.url,
  sameAs: [siteConfig.github, siteConfig.linkedin, siteConfig.playStore],
};

const articleSchema = isArticle
  ? {
      "@context": "https://schema.org",
      "@type": "TechArticle",
      headline: title,
      description: description,
      image: new URL(image, Astro.site).toString(),
      author: {
        "@type": "Person",
        name: siteConfig.author,
        url: siteConfig.url,
      },
      inLanguage: language,
    }
  : null;

const isLegalPage = /^\/(en\/)?(privacy-policy|disclaimer|terms-of-service|about)\/?$/.test(currentPath);
const shouldShowAds = siteConfig.googleAdsenseId && !isLegalPage;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title} | {domainName}</title>
<meta name="description" content={description} />
<meta name="google-site-verification" content="lw-c6ZH1h_WwhMgPtvg-uG6ZXuxprZ2GlVwY3oPFV7Q" />
{noindex && <meta name="robots" content="noindex, follow" />}

{/* SEO Multi-bahasa (Hreflang Dinamis & Aman dari 404) */}
<link rel="canonical" href={canonicalURL} />
<link rel="alternate" hreflang={language} href={canonicalURL} />
{hasAlternate && alternateURL && (
  <link rel="alternate" hreflang={alternateLang} href={alternateURL} />
)}
<link rel="alternate" hreflang="x-default" href={xDefaultURL} />

{/* Open Graph / Facebook / LinkedIn */}
<meta property="og:type" content={isArticle ? "article" : "website"} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.site)} />

{/* Twitter / Telegram / Discord Cards */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, Astro.site)} />

{/* Schema.org JSON-LD */}
<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
{isArticle && (
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
)}

{/* PWA & Favicon */}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/images/favicon-96x96.png" type="image/png">
<link rel="manifest" href="/manifest.json" />
<meta name="theme-color" content="#c6ff00" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black" />
<link rel="apple-touch-icon" href="/images/icon-192.png" />

{/* Google AdSense (Lazy-loaded & Terfilter) */}
{shouldShowAds && (
  <>
  <meta name="google-adsense-account" content={siteConfig.googleAdsenseId} />
  <script is:inline define:vars={{ adId: siteConfig.googleAdsenseId }}>
    let adsLoaded = false;
    const loadAdsense = () => {
      if (adsLoaded) return;
      adsLoaded = true;
      const script = document.createElement("script");
      script.src = `https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adId}`;
      script.async = true;
      script.crossOrigin = "anonymous";
      document.head.appendChild(script);
    };
    window.addEventListener("scroll", loadAdsense, { once: true, passive: true });
    window.addEventListener("mousemove", loadAdsense, { once: true, passive: true });
    window.addEventListener("touchstart", loadAdsense, { once: true, passive: true });
    setTimeout(loadAdsense, 5000);
  </script>
  </>
)}