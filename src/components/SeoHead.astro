---
import { siteConfig, siteTranslation } from "../config/site";

export interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  isArticle?: boolean;
  language: "id" | "en";
  enSlug?: string;
  idSlug?: string;
  languageAlternate?: boolean;
  pubDate?: Date;
  updatedDate?: Date;
  noindex?: boolean;
}

const {
  title,
  description,
  image = "/images/og-default.webp",
  imageAlt = title,
  isArticle = false,
  language,
  enSlug,
  idSlug,
  languageAlternate = true,
  pubDate,
  updatedDate,
  noindex = false,
} = Astro.props;

const t = siteTranslation[language];
const domainName = siteConfig.url.replace(/^https?:\/\//, "");
const ogSiteName = t.siteTitle;
const ogLocale = language === "id" ? "id_ID" : "en_US";

// Prevent content strings from prematurely closing an embedded JSON-LD script.
function serializeJsonLd(value: unknown): string {
  return JSON.stringify(value).replace(/[<>&]/g, (character) => {
    const escapes: Record<string, string> = {
      "<": "\\u003c",
      ">": "\\u003e",
      "&": "\\u0026",
    };
    return escapes[character];
  });
}

// Keep canonical URLs consistent with the directory-style static routes.
const trimmedPath = Astro.url.pathname.replace(/\/+$/, "");
const currentPath = trimmedPath || "/";
const canonicalPath = currentPath === "/" ? "/" : `${currentPath}/`;
const canonicalURL = new URL(canonicalPath, Astro.site);

let alternatePath = "";
let hasAlternate = false;

if (isArticle) {
  if (language === "id" && enSlug) {
    alternatePath = `/en/blog/${enSlug}/`;
    hasAlternate = true;
  } else if (language === "en" && idSlug) {
    alternatePath = `/blog/${idSlug}/`;
    hasAlternate = true;
  }
} else if (languageAlternate && !noindex) {
  // Only create a static-page alternate when that translated route exists.
  // Root is the only route that does not use a trailing slash suffix.
  if (language === "id") {
    alternatePath = currentPath === "/" ? "/en/" : `/en${currentPath}/`;
  } else {
    const idPath = currentPath.replace(/^\/en(?=\/|$)/, "") || "/";
    alternatePath = idPath === "/" ? "/" : `${idPath}/`;
  }
  hasAlternate = true;
}

const alternateLang = language === "id" ? "en" : "id";
const alternateURL = hasAlternate
  ? new URL(alternatePath, Astro.site)
  : null;
const alternateLocale = language === "id" ? "en_US" : "id_ID";

const xDefaultURL = language === "id" && hasAlternate && alternateURL
  ? alternateURL
  : canonicalURL;

const authorId = new URL("/#person", Astro.site).toString();
const authorProfileURL = new URL("/about/", Astro.site);
const isProfilePage = currentPath === "/about" || currentPath === "/en/about";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": authorId,
  name: siteConfig.author,
  jobTitle: t.heroTitle,
  url: authorProfileURL.toString(),
  sameAs: [siteConfig.github, siteConfig.linkedin, siteConfig.playStore],
};

const profilePageSchema = isProfilePage
  ? {
      "@context": "https://schema.org",
      "@type": "ProfilePage",
      "@id": `${canonicalURL.toString()}#profilepage`,
      url: canonicalURL.toString(),
      mainEntity: { "@id": authorId },
    }
  : null;

const articleSchema = isArticle
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description,
      image: new URL(image, Astro.site).toString(),
      author: {
        "@type": "Person",
        "@id": authorId,
        name: siteConfig.author,
        url: authorProfileURL.toString(),
      },
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": canonicalURL.toString(),
      },
      ...(pubDate ? { datePublished: pubDate.toISOString() } : {}),
      ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
      inLanguage: language,
    }
  : null;

const isLegalPage = /^\/(en\/)?(privacy-policy|disclaimer|terms-of-service|about)$/.test(currentPath);
const shouldShowAds = siteConfig.googleAdsenseId && !isLegalPage;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{title} | {domainName}</title>
<meta name="description" content={description} />
<meta name="google-site-verification" content="lw-c6ZH1h_WwhMgPtvg-uG6ZXuxprZ2GlVwY3oPFV7Q" />
{noindex && <meta name="robots" content="noindex, follow" />}

<link rel="canonical" href={canonicalURL} />
{!noindex && <link rel="alternate" hreflang={language} href={canonicalURL} />}
{!noindex && hasAlternate && alternateURL && (
  <link rel="alternate" hreflang={alternateLang} href={alternateURL} />
)}
{!noindex && <link rel="alternate" hreflang="x-default" href={xDefaultURL} />}

<meta property="og:type" content={isArticle ? "article" : "website"} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.site)} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:site_name" content={ogSiteName} />
<meta property="og:locale" content={ogLocale} />
{hasAlternate && !noindex && (
  <meta property="og:locale:alternate" content={alternateLocale} />
)}
{isArticle && pubDate && (
  <>
    <meta property="article:published_time" content={pubDate.toISOString()} />
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    <meta property="article:author" content={new URL("/about/", Astro.site)} />
  </>
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, Astro.site)} />

<script type="application/ld+json" set:html={serializeJsonLd(personSchema)} />
{profilePageSchema && (
  <script type="application/ld+json" set:html={serializeJsonLd(profilePageSchema)} />
)}
{isArticle && (
  <script type="application/ld+json" set:html={serializeJsonLd(articleSchema)} />
)}

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/images/favicon-96x96.png" type="image/png" />
<link rel="manifest" href="/manifest.json" />
<meta name="theme-color" content="#c6ff00" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black" />
<link rel="apple-touch-icon" href="/images/icon-192.png" />

{shouldShowAds && (
  <>
    <meta name="google-adsense-account" content={siteConfig.googleAdsenseId} />
    <script is:inline define:vars={{ adId: siteConfig.googleAdsenseId }}>
      let adsLoaded = false;
      const loadAdsense = () => {
        if (adsLoaded) return;
        adsLoaded = true;
        const script = document.createElement("script");
        script.src = `https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adId}`;
        script.async = true;
        script.crossOrigin = "anonymous";
        document.head.appendChild(script);
      };
      window.addEventListener("scroll", loadAdsense, { once: true, passive: true });
      window.addEventListener("mousemove", loadAdsense, { once: true, passive: true });
      window.addEventListener("touchstart", loadAdsense, { once: true, passive: true });
      setTimeout(loadAdsense, 5000);
    </script>
  </>
)}
