---
import { siteConfig, siteTranslation } from "../../config/site";

export interface Props {
  language: "id" | "en";
}

const { language } = Astro.props;
const t = siteTranslation[language];
const { repo, repoId, category, categoryId } = siteConfig.giscus;
const giscusLang = language === "id" ? "id" : "en";

const buttonText = language === "id"
  ? "💬 Tampilkan Komentar (GitHub)"
  : "💬 Load Comments (GitHub)";
const loadingText = language === "id"
  ? "Memuat komentar..."
  : "Loading comments...";
const retryText = language === "id"
  ? "Gagal memuat komentar. Coba lagi."
  : "Failed to load comments. Try again.";
---

<section
  class="mt-16 bg-surface-panel border-4 border-white p-6 md:p-8 shadow-neo-cyan-8"
>
  <h2
    class="mb-6 border-b-4 border-border-muted pb-4 text-2xl font-black uppercase tracking-tight"
  >
    {t.discussionTitle}
  </h2>

  <div
    id="giscus-container"
    class="w-full flex flex-col items-center justify-center min-h-[100px]"
  >
    <button
      id="load-giscus-btn"
      type="button"
      class="bg-brand-lime text-black font-mono font-bold px-6 py-4 border-4 border-white shadow-neo-paper-6 hover:bg-brand-cyan active:translate-y-1 active:translate-x-1 active:shadow-none transition-all disabled:opacity-50 disabled:cursor-wait"
      aria-live="polite"
    >
      {buttonText}
    </button>
  </div>
</section>

<script
  is:inline
  define:vars={{ giscusLang, repo, repoId, category, categoryId, loadingText, retryText }}
>
  document.addEventListener("DOMContentLoaded", () => {
    const btn = document.getElementById("load-giscus-btn");
    const container = document.getElementById("giscus-container");

    if (!(btn instanceof HTMLButtonElement) || !(container instanceof HTMLElement)) {
      return;
    }

    let isLoading = false;

    btn.addEventListener("click", () => {
      if (isLoading || container.querySelector("iframe")) return;

      isLoading = true;
      btn.disabled = true;
      btn.setAttribute("aria-busy", "true");
      btn.textContent = loadingText;

      const script = document.createElement("script");
      script.src = "https://giscus.app/client.js";
      script.setAttribute("data-repo", repo);
      script.setAttribute("data-repo-id", repoId);
      script.setAttribute("data-category", category);
      script.setAttribute("data-category-id", categoryId);
      script.setAttribute("data-mapping", "pathname");
      script.setAttribute("data-strict", "0");
      script.setAttribute("data-reactions-enabled", "1");
      script.setAttribute("data-emit-metadata", "0");
      script.setAttribute("data-input-position", "bottom");
      script.setAttribute("data-theme", "noborder_dark");
      script.setAttribute("data-lang", giscusLang);
      script.setAttribute("crossorigin", "anonymous");
      script.async = true;

      script.onload = () => {
        btn.hidden = true;
        btn.removeAttribute("aria-busy");
        isLoading = false;
      };

      script.onerror = () => {
        script.remove();
        isLoading = false;
        btn.disabled = false;
        btn.removeAttribute("aria-busy");
        btn.textContent = retryText;
      };

      container.appendChild(script);
    });
  });
</script>
