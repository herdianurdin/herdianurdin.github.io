---
// src/components/article/Giscus.astro
import { siteConfig, siteTranslation } from "../../config/site";

export interface Props {
  language: "id" | "en";
}
const { language } = Astro.props;

const t = siteTranslation[language];
const { repo, repoId, category, categoryId } = siteConfig.giscus;
const giscusLang = language === "id" ? "id" : "en";

// Teks dinamis untuk tombol
const btnText =
  language === "id" ? "Tampilkan Komentar (GitHub)" : "Load Comments (GitHub)";
---

<section
  class="mt-16 bg-neutral-800 border-4 border-white p-6 md:p-8 shadow-[8px_8px_0px_0px_#00e5ff]"
>
  <h3
    class="text-2xl font-black mb-6 uppercase tracking-tight border-b-4 border-neutral-600 pb-4"
  >
    {t.discussionTitle}
  </h3>

  <!-- Kontainer Giscus -->
  <div
    id="giscus-container"
    class="w-full flex flex-col items-center justify-center min-h-[100px]"
  >
    <!-- Tombol Pemicu -->
    <button
      id="load-giscus-btn"
      class="bg-[#c6ff00] text-black font-mono font-bold px-6 py-4 border-4 border-white shadow-[6px_6px_0px_0px_#fff] hover:bg-[#00e5ff] active:translate-y-1 active:translate-x-1 active:shadow-none transition-all"
    >
      💬 {btnText}
    </button>
  </div>
</section>

<!-- Skrip Pemanggil (Hanya aktif saat diklik) -->
<script
  is:inline
  define:vars={{ giscusLang, repo, repoId, category, categoryId }}
>
  document.addEventListener("DOMContentLoaded", () => {
    const btn = document.getElementById("load-giscus-btn");
    const container = document.getElementById("giscus-container");

    if (btn && container) {
      btn.addEventListener("click", () => {
        // 1. Ubah teks tombol menjadi indikator loading
        btn.innerText = "Memuat koneksi ke GitHub...";
        btn.classList.add("opacity-50", "pointer-events-none");

        // 2. Buat skrip Giscus
        const script = document.createElement("script");
        script.src = "https://giscus.app/client.js";
        script.setAttribute("data-repo", repo);
        script.setAttribute("data-repo-id", repoId);
        script.setAttribute("data-category", category);
        script.setAttribute("data-category-id", categoryId);
        script.setAttribute("data-mapping", "pathname");
        script.setAttribute("data-strict", "0");
        script.setAttribute("data-reactions-enabled", "1");
        script.setAttribute("data-emit-metadata", "0");
        script.setAttribute("data-input-position", "bottom");
        script.setAttribute("data-theme", "noborder_dark");
        script.setAttribute("data-lang", giscusLang);
        script.setAttribute("crossorigin", "anonymous");
        script.async = true;

        // 3. Sembunyikan tombol setelah skrip selesai dimuat oleh iframe Giscus
        // Kita gunakan sedikit delay untuk memberi waktu iframe dirender
        setTimeout(() => {
          btn.style.display = "none";
        }, 1500);

        // 4. Suntikkan skrip ke dalam DOM
        container.appendChild(script);
      });
    }
  });
</script>
