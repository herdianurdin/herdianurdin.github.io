---
// src/components/article/TableOfContents.astro
export interface Heading {
  depth: number;
  slug: string;
  text: string;
}

export interface Props {
  headings: Heading[];
  language?: "id" | "en";
}

const { headings, language = "id" } = Astro.props;

// Filter tajuk untuk menyembunyikan H1 (karena sudah jadi judul utama artikel)
// dan H4, H5, H6 agar daftar isi tidak terlalu panjang.
const filteredHeadings =
  headings?.filter((h) => h.depth === 2 || h.depth === 3) || [];

const title = language === "id" ? "Daftar Isi" : "Table of Contents";
---

{
  filteredHeadings.length > 0 && (
    <details
      class="bg-surface-card border-4 border-white p-5 mb-10 shadow-neo-cyan-6 group"
    >
      <summary class="flex list-none cursor-pointer items-center justify-between font-mono text-xl font-black uppercase text-brand-lime marker:hidden md:text-2xl">
        <span>{title}</span>
        <span aria-hidden="true" class="text-white transition-transform duration-200 group-open:rotate-180">
          ▼
        </span>
      </summary>

      <ul class="mt-5 flex flex-col gap-3 border-t-4 border-white pt-5">
        {filteredHeadings.map((heading) => (
          <li
            class={`transition-transform hover:translate-x-2 ${
              heading.depth === 3
                ? "ml-4 border-l-4 border-border-muted pl-4"
                : ""
            }`}
          >
            <a
              href={`#${heading.slug}`}
              class="text-neutral-300 hover:text-white font-bold font-mono text-sm md:text-base hover:underline underline-offset-4 decoration-brand-lime decoration-4 transition-colors"
            >
              {heading.depth === 3 ? "└ " : "■ "}
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </details>
  )
}
