---
import { Image } from "astro:assets";
import { siteConfig, siteTranslation } from "../../config/site";

export interface Props {
  language: "id" | "en";
}

const { language } = Astro.props;
const t = siteTranslation[language];
const profileUrl = language === "id" ? "/about/" : "/en/about/";
const authorLabel = language === "id" ? "TENTANG PENULIS" : "ABOUT THE AUTHOR";
---

<aside
  class="my-8 border-y-2 border-border-muted border-l-4 border-l-brand-cyan bg-surface-card px-4 py-5 sm:px-6"
  aria-labelledby="author-box-heading"
>
  <div class="flex flex-col items-center gap-3 text-center sm:flex-row sm:items-center sm:gap-5 sm:text-left">
    <Image
      src={siteConfig.profileImage}
      format="webp"
      widths={[128, 256]}
      sizes="4rem"
      quality={80}
      alt={language === "id" ? `Foto profil ${siteConfig.author}` : `Profile photo of ${siteConfig.author}`}
      loading="lazy"
      decoding="async"
      class="h-16 w-16 shrink-0 border-2 border-white bg-surface-panel object-contain sm:h-[4.5rem] sm:w-[4.5rem]"
    />

    <div class="w-full min-w-0">
      <p class="mb-1 font-mono text-[0.65rem] font-black uppercase tracking-widest text-brand-fuchsia">
        {authorLabel}
      </p>
      <h2 id="author-box-heading" class="text-lg font-black tracking-tight text-white sm:text-xl">
        <a href={profileUrl} class="author-name-link">
          {siteConfig.author}
          <span aria-hidden="true" class="ml-1 text-sm text-brand-cyan">↗</span>
        </a>
      </h2>
      <p class="mt-0.5 font-mono text-xs font-bold text-brand-lime sm:text-sm">{t.heroTitle}</p>
      <p class="mt-2 text-sm leading-relaxed text-neutral-300">{t.authorBio}</p>
    </div>
  </div>
</aside>

<style>
  .author-name-link {
    color: inherit;
    text-decoration: none;
    text-underline-offset: 3px;
  }

  .author-name-link:hover {
    text-decoration: underline;
  }

  .author-name-link:focus-visible {
    border-radius: 1px;
    outline: 3px solid var(--color-brand-lime);
    outline-offset: 3px;
  }
</style>
