---
// src/components/article/AuthorBox.astro
import { siteConfig, siteTranslation } from "../../config/site";

export interface Props {
  language: "id" | "en";
}
const { language } = Astro.props;

// Ekstrak data berdasarkan properti bahasa
const t = siteTranslation[language as keyof typeof siteTranslation];
const homeUrl = language === "id" ? "/" : "/en/";
---

<div
  class="bg-black border-4 border-white p-6 md:p-8 flex flex-col md:flex-row gap-6 items-center md:items-start shadow-[8px_8px_0px_0px_#d946ef] mb-8"
>
  <img
    src={siteConfig.profileImage}
    alt={`Foto profil ${siteConfig.author}`}
    width={96}
    height={96}
    loading="lazy"
    class="w-24 h-24 border-4 border-white object-cover grayscale hover:grayscale-0 transition-all"
  />

  <div>
    <h3 class="text-2xl font-black mb-2 uppercase">{t.authorTitle}</h3>

    <p class="text-neutral-400 mb-6 leading-relaxed">{t.authorBio}</p>

    <a
      href={homeUrl}
      aria-label={t.ariaProfileBtn}
      class="inline-block bg-white text-black font-bold font-mono px-4 py-2 border-2 border-white shadow-[4px_4px_0px_0px_#c6ff00] hover:bg-[#c6ff00] hover:shadow-[6px_6px_0px_0px_#00e5ff] active:translate-y-1 active:translate-x-1 active:shadow-none hover:border-black transition-all"
    >
      {t.profileBtn}
    </a>
  </div>
</div>
