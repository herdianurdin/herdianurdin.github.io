---
// src/pages/404.astro
import "../styles/global.css";
import { siteConfig, siteTranslation } from "../config/site";

// Tarik data untuk kedua bahasa sekaligus karena halaman ini bersifat hibrida
const tId = siteTranslation.id;
const tEn = siteTranslation.en;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 - Null Pointer Exception | {siteConfig.author}</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body
    class="min-h-screen w-full bg-neutral-900 text-white font-sans flex items-center justify-center p-4 md:p-8 selection:bg-[#c6ff00] selection:text-black overflow-x-hidden relative"
  >
    {/* Latar Belakang Pola Titik */}
    <div
      class="absolute inset-0 z-0 opacity-10"
      style="background-image: radial-gradient(#ffffff 2px, transparent 2px); background-size: 32px 32px; background-position: 0 0;"
    >
    </div>

    {/* Kotak Utama Neo-Brutalism */}
    <main
      class="relative z-10 bg-black border-4 border-white max-w-3xl w-full p-6 md:p-12 shadow-[16px_16px_0px_0px_#00e5ff] flex flex-col items-center justify-center text-center mx-auto"
    >
      {/* Lencana Status */}
      <div
        class="bg-[#d946ef] text-white font-mono font-bold text-sm md:text-base px-4 py-1 border-4 border-white shadow-[4px_4px_0px_0px_#fff] mb-6 uppercase tracking-wider -rotate-2"
      >
        {siteConfig.errorBadge}
      </div>

      {/* Teks 404 */}
      <h1
        class="text-7xl md:text-9xl font-black tracking-tighter text-[#c6ff00] mb-2 drop-shadow-[6px_6px_0px_#fff]"
      >
        404
      </h1>

      {/* Judul Bilingual */}
      <h2 class="text-2xl md:text-3xl font-black uppercase mb-8 leading-tight">
        {tEn.notFoundTitle}
        <br class="md:hidden" />
        <span class="text-neutral-500 hidden md:inline">/</span>
        {tId.notFoundTitle}
      </h2>

      {/* Kotak Terminal Bilingual */}
      <div
        class="w-full bg-neutral-800 border-4 border-white p-5 md:p-8 mb-10 text-left font-mono text-sm md:text-base"
      >
        <p class="text-[#c6ff00] mb-2">$ throw new Exception("404");</p>
        <p class="text-red-400 font-bold mb-8">
          {siteConfig.errorException}
        </p>

        {/* Pesan Bahasa Inggris */}
        <div class="border-l-4 border-[#00e5ff] pl-4 mb-6">
          <p class="text-white font-bold mb-1">{tEn.errorLogLabel}</p>
          <p class="text-neutral-400 leading-relaxed">
            {tEn.errorLogMsg}
          </p>
        </div>

        {/* Pesan Bahasa Indonesia */}
        <div class="border-l-4 border-[#d946ef] pl-4 mb-4">
          <p class="text-white font-bold mb-1">{tId.errorLogLabel}</p>
          <p class="text-neutral-400 leading-relaxed">
            {tId.errorLogMsg}
          </p>
        </div>

        <p class="text-[#c6ff00] animate-pulse font-black text-xl mt-4">_</p>
      </div>

      {/* Tombol Aksi */}
      <div
        class="grid grid-cols-1 md:grid-cols-2 gap-4 w-full font-mono font-bold uppercase text-sm md:text-base"
      >
        {/* Tombol Kembali */}
        <button
          onclick="history.back()"
          aria-label={`${tEn.btnBack} / ${tId.btnBack}`}
          class="bg-neutral-800 text-white px-6 py-4 border-4 border-white hover:bg-white hover:text-black active:translate-y-1 active:translate-x-1 active:shadow-none transition-all shadow-[6px_6px_0px_0px_#fff] w-full text-center"
        >
          &larr; {tEn.btnBack} ({tId.btnBack})
        </button>

        {/* Tombol Beranda Utama */}
        <a
          href="/"
          aria-label={`${tEn.btnHome} / ${tId.btnHome}`}
          class="bg-[#c6ff00] text-black px-6 py-4 border-4 border-white hover:bg-[#00e5ff] hover:shadow-[6px_6px_0px_0px_#00e5ff] active:translate-y-1 active:translate-x-1 active:shadow-none transition-all shadow-[6px_6px_0px_0px_#fff] w-full text-center"
        >
          {tEn.btnHome} ({tId.btnHome}) &rarr;
        </a>
      </div>
    </main>
  </body>
</html>
