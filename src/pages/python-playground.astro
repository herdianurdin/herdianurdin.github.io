---
import PlaygroundLayout from "../layouts/PlaygroundLayout.astro";
import CodeEditor from "../components/playground/CodeEditor.astro";
import Terminal from "../components/playground/Terminal.astro";
import PlaygroundModals from "../components/playground/PlaygroundModals.astro";

const seoTitle = "Python Web Playground";
const seoDescription =
  "Lingkungan eksekusi Python native di browser. Mendukung multi-file import dan terminal interaktif.";
---

<PlaygroundLayout title={seoTitle} description={seoDescription}>
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.css"
    integrity="sha384-zaeBlB/vwYsDRSlFajnDd7OydJ0cWk+c2OWybl3eSUf6hW2EbhlCsQPqKr3gkznT"
    crossorigin="anonymous"
  />
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/theme/dracula.min.css"
    integrity="sha384-ccdJwIIg/K0Ab6aXF4MPACh7ckk61tvQFTrfkhXZEALgAETURNZIAuQLcS/aPbrM"
    crossorigin="anonymous"
  />
  <script
    is:inline
    defer
    src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.js"
    integrity="sha384-ZYmwuq4n2gOcNxMSiJ6jyTj+BbIrilr7p6dlq6q5nmSWKmsH9UU4K1qqjycMkfmR"
    crossorigin="anonymous"
  ></script>
  <script
    is:inline
    defer
    src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/python/python.min.js"
    integrity="sha384-Xy+2exU6lBoT4OpUOtnQb+cUpn+nlJQEHvRobWVtwz6wIsw4oNoO7xyd/l8rYgMy"
    crossorigin="anonymous"
  ></script>
  <script
    is:inline
    defer
    src="https://cdn.jsdelivr.net/npm/skulpt@1.2.0/dist/skulpt.min.js"
    integrity="sha384-xKdsXwmsmIOznHB5nMknv/xlle/iCeNcEabalNUx5oSJIBHdxM1Qfnb50Y/w1zRU"
    crossorigin="anonymous"
  ></script>
  <script
    is:inline
    defer
    src="https://cdn.jsdelivr.net/npm/skulpt@1.2.0/dist/skulpt-stdlib.js"
    integrity="sha384-b3ccRbwiT8uaTe6Waa6GHLF96Yp3wDxTEVKf885pMqeZUqj4hG2zY3rwMD7WmX1g"
    crossorigin="anonymous"
  ></script>

  <header
    class="bg-surface-card border-b-4 border-brand-cyan px-4 md:px-6 py-4 flex justify-between items-center shrink-0 z-20"
  >
    <a
      href="/playgrounds/"
      aria-label="Kembali ke daftar Playgrounds"
      class="text-white font-black text-base md:text-xl uppercase hover:text-brand-cyan transition-colors tracking-tighter"
    >
      <div class="flex items-center gap-2">
        <svg
          class="w-5 h-5 hidden sm:block"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="square"
            stroke-linejoin="miter"
            stroke-width="3"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"
          ></path>
        </svg>
        <div>
          HERDIANURDIN.<span class="text-brand-lime">MY.ID</span>
        </div>
      </div>
    </a>

    <div class="flex items-center gap-4">
      <button
        id="guide-open-btn"
        type="button"
        aria-haspopup="dialog"
        aria-controls="modal-guide"
        class="bg-brand-lime text-black font-black text-xs md:text-sm px-3 py-1.5 border-2 border-white shadow-neo-paper-2 hover:bg-white hover:translate-y-px hover:translate-x-px hover:shadow-none transition-all"
        aria-label="Buka Panduan Edukasi"
      >
        📖 PANDUAN
      </button>

    </div>
  </header>

  <div class="bg-surface-page px-4 md:px-8 pt-3">
    <h1
      id="playground-heading"
      tabindex="-1"
      class="text-white font-bold text-sm md:text-base uppercase tracking-widest scroll-mt-4"
    >
      PYTHON <span class="text-brand-lime">PLAYGROUND</span>
    </h1>
  </div>

  <div
    class="flex flex-1 flex-col lg:flex-row overflow-y-auto lg:overflow-hidden p-4 md:p-8 gap-6 md:gap-8 bg-surface-page"
  >
    <div class="flex-1 flex min-w-0 min-h-[400px] lg:min-h-0">
      <CodeEditor />
    </div>
    <div class="flex-1 flex min-w-0 min-h-[300px] lg:min-h-0">
      <Terminal />
    </div>
  </div>

  <PlaygroundModals />

  <style is:global>
    .CodeMirror {
      width: 100%;
      min-width: 0;
      font-family: "Fira Code", monospace;
      font-size: 15px;
      height: 100% !important;
    }
    .CodeMirror-gutters {
      border-right: 2px solid var(--color-editor-gutter) !important;
      background-color: var(--color-editor) !important;
    }
    ::-webkit-scrollbar {
      width: 14px;
      height: 14px;
    }
    ::-webkit-scrollbar-track {
      background: var(--color-editor-panel);
      border-left: 2px solid var(--color-white);
    }
    ::-webkit-scrollbar-thumb {
      background: var(--color-brand-lime);
      border: 2px solid var(--color-editor-panel);
    }
    ::-webkit-scrollbar-thumb:hover {
      background: var(--color-brand-cyan);
    }
    .terminal-input {
      background: transparent;
      border: none;
      outline: none;
      color: var(--color-white);
      font-family: inherit;
      font-size: inherit;
      width: 60%;
      margin-left: 8px;
      border-bottom: 2px solid var(--color-brand-lime);
    }
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>

  <script src="../scripts/python-playground.js"></script>
</PlaygroundLayout>
