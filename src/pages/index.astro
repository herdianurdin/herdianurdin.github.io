---
import BaseLayout from "../layouts/BaseLayout.astro";
import EditorialHero from "../components/home/EditorialHero.astro";
import HeroProfile from "../components/home/HeroProfile.astro";
import Portfolio from "../components/home/Portfolio.astro";
import ArticleCard from "../components/ui/ArticleCard.astro";
import { siteTranslation } from "../config/site";
import { getCollection } from "astro:content";

const siteConfigs = siteTranslation.id;
const allPosts = await getCollection("id", ({ data }) => data.isDraft !== true);

const latestPosts = allPosts
  .sort((a, b) => {
    const timeA = a.data.pubDate.valueOf();
    const timeB = b.data.pubDate.valueOf();
    if (timeA !== timeB) return timeB - timeA;
    return a.data.title.localeCompare(b.data.title);
  })
  .slice(0, 4);
---

<BaseLayout
  title={siteConfigs.siteTitle}
  description={siteConfigs.siteDescription}
  language="id"
  headerVariant="home"
>
  <main id="main-content" tabindex="-1" class="site-container page-main page-main--home">
    <EditorialHero language="id" />

    <section aria-labelledby="latest-journal-heading" class="mb-16">
      <div class="mb-8 flex items-center gap-4">
        <h2 id="latest-journal-heading" class="shrink-0 text-2xl font-black uppercase tracking-tight md:text-3xl">
          {siteConfigs.latestJournal}
        </h2>
        <div class="h-1 flex-grow bg-white" aria-hidden="true"></div>
      </div>

      {latestPosts.length > 0 ? (
        <>
          <div class="grid gap-6 md:grid-cols-2 md:gap-8">
            {latestPosts.map((post) => <ArticleCard post={post} language="id" />)}
          </div>
          <div class="mt-9 text-center">
            <a
              href="/blog/"
              class="inline-flex min-h-12 items-center justify-center border-4 border-white bg-surface-card px-7 py-3 font-mono text-sm font-black uppercase text-white shadow-neo-paper-4 transition-transform hover:-translate-y-1 hover:bg-brand-lime hover:text-black hover:shadow-neo-lime-6 focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-brand-lime active:translate-x-1 active:translate-y-1 active:shadow-none"
            >
              {siteConfigs.openArchive}
            </a>
          </div>
        </>
      ) : (
        <div class="flex flex-col items-center justify-center border-4 border-white bg-surface-card px-6 py-12 text-center shadow-neo-cyan-6">
          <h3 class="mb-3 text-2xl font-black uppercase tracking-tight text-white md:text-3xl">
            {siteConfigs.emptyPostTitle}
          </h3>
          <p class="max-w-lg font-mono text-sm leading-relaxed text-copy-muted">
            {siteConfigs.emptyPostMessage}
          </p>
        </div>
      )}
    </section>

    <HeroProfile language="id" />
    <Portfolio language="id" />
  </main>
</BaseLayout>
