---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import type { Page, PaginateFunction } from "astro";
import ArchivePage from "../../../components/archive/ArchivePage.astro";
import { siteConfig } from "../../../config/site";

export async function getStaticPaths({
  paginate,
}: {
  paginate: PaginateFunction;
}) {
  const allPosts = await getCollection("en", ({ data }) => {
    return data.isDraft !== true;
  });

  const sortedPosts = allPosts.sort((a, b) => {
    const timeA = a.data.pubDate.valueOf();
    const timeB = b.data.pubDate.valueOf();

    if (timeA !== timeB) {
      return timeB - timeA;
    }
    return a.data.title.localeCompare(b.data.title);
  });

  return paginate(sortedPosts, { pageSize: siteConfig.maxPosts });
}

export interface Props {
  page: Page<CollectionEntry<"en">>;
}

const { page } = Astro.props;
---

<ArchivePage page={page} language="en" />
