---
import { getCollection, render } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { getRelatedArticles } from "../../utils/related-articles.mjs";

export async function getStaticPaths() {
  const posts = await getCollection("id", ({ data }) => data.isDraft !== true);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, relatedPosts: getRelatedArticles(post, posts) },
  }));
}

const { post, relatedPosts } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogLayout frontmatter={post.data} language="id" headings={headings} relatedPosts={relatedPosts}>
  <Content />
</BlogLayout>
