---
import SeoHead from "../components/SeoHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AuthorBox from "../components/article/AuthorBox.astro";
import Giscus from "../components/article/Giscus.astro";
import TableOfContents from "../components/article/TableOfContents.astro";
import "@fontsource/inter/400.css";
import "@fontsource/inter/700.css";
import "@fontsource/inter/900.css";
import "@fontsource/fira-code/400.css";
import "@fontsource/fira-code/700.css";
import "../styles/global.css";

const { frontmatter, headings, language } = Astro.props;
const homeUrl = language === "id" ? "/" : "/en/";
const translationHref = language === "id"
  ? (frontmatter.enSlug ? `/en/blog/${frontmatter.enSlug}/` : undefined)
  : (frontmatter.idSlug ? `/blog/${frontmatter.idSlug}/` : undefined);
---

<html lang={language}>
  <head>
    <SeoHead
      title={frontmatter.title}
      description={frontmatter.description}
      image={frontmatter.coverImage}
      isArticle={true}
      language={language}
      enSlug={frontmatter.enSlug}
      idSlug={frontmatter.idSlug}
      pubDate={frontmatter.pubDate}
      updatedDate={frontmatter.updatedDate}
    />
  </head>
  <body
    class="overflow-x-hidden min-h-screen bg-neutral-900 text-white font-sans selection:bg-[#c6ff00] selection:text-black antialiased flex flex-col"
  >
    <Header currentLang={language} variant="article" translationHref={translationHref} />

    <main class="max-w-4xl mx-auto p-4 md:p-8 mt-8 flex-grow w-full">
      <article
        class="bg-neutral-800 border-4 border-white shadow-[12px_12px_0px_0px_#c6ff00] mb-12"
      >
        {
          frontmatter.coverImage && (
            <div class="border-b-4 border-white relative">
              <img
                src={frontmatter.coverImage}
                alt={`Ilustrasi: ${frontmatter.title}`}
                width="1200"
                height="630"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="w-full aspect-[1200/630] object-cover object-center grayscale hover:grayscale-0 transition-all duration-500 border-4 border-white"
                onerror="this.removeAttribute('onerror'); this.setAttribute('src', 'https://placehold.co/1200x630/000000/c6ff00.png?text=Gambar+Tidak+Tersedia');"
              />
            </div>
          )
        }
        <div class="p-6 md:p-12">
          <header class="mb-10">
            <div class="flex flex-wrap gap-2 mb-6">
              {
                frontmatter.tags?.map((tag: string) => (
                  <span class="bg-[#c6ff00] text-black font-mono text-xs font-bold px-3 py-1 border-2 border-black uppercase">
                    {tag}
                  </span>
                ))
              }
            </div>

            <h1
              class="text-4xl md:text-5xl font-black tracking-tight mb-6 leading-tight"
            >
              {frontmatter.title}
            </h1>

            <div
              class="font-mono text-sm text-neutral-400 font-bold border-t-2 border-neutral-600 pt-4 flex flex-col md:flex-row justify-between gap-2"
            >
              <span>
                {language === "id" ? "Oleh" : "By"}
                <a
                  href={homeUrl}
                  class="text-white hover:text-[#c6ff00] underline underline-offset-4 decoration-2 ml-1"
                >
                  Herdi Herdianurdin
                </a>
              </span>
              <time datetime={frontmatter.pubDate.toISOString()}>
                {
                  new Date(frontmatter.pubDate).toLocaleDateString(
                    language === "id" ? "id-ID" : "en-US",
                    { year: "numeric", month: "long", day: "numeric" },
                  )
                }
              </time>
              {frontmatter.updatedDate && (
                <time datetime={frontmatter.updatedDate.toISOString()}>
                  {language === "id" ? "Diperbarui" : "Updated"}: {new Date(frontmatter.updatedDate).toLocaleDateString(
                    language === "id" ? "id-ID" : "en-US",
                    { year: "numeric", month: "long", day: "numeric" },
                  )}
                </time>
              )}
            </div>
          </header>

          <TableOfContents headings={headings} language={language} />

          <div
            class="prose prose-invert prose-lg max-w-none prose-pre:border-4 prose-pre:border-white prose-pre:rounded-none prose-pre:shadow-[8px_8px_0px_0px_#00e5ff] prose-headings:font-black prose-headings:scroll-mt-24 prose-a:text-[#c6ff00] prose-a:underline-offset-4 hover:prose-a:bg-[#c6ff00] hover:prose-a:text-black"
          >
            <slot />
            {frontmatter.faq?.length > 0 && (
              <section class="mt-12" aria-labelledby="article-faq-heading">
                <h2 id="article-faq-heading">
                  {language === "id" ? "Pertanyaan yang Sering Diajukan" : "Frequently Asked Questions"}
                </h2>
                {frontmatter.faq.map((item: { q: string; a: string }) => (
                  <div class="mb-8">
                    <h3>{item.q}</h3>
                    <p>{item.a}</p>
                  </div>
                ))}
              </section>
            )}
          </div>

          <footer class="mt-16 pt-8 border-t-4 border-white">
            <AuthorBox language={language} />
          </footer>
        </div>
      </article>

      <section class="mt-12">
        <Giscus language={language} />
      </section>
    </main>

    <Footer language={language} />
    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        // Keep wide Markdown tables scrollable on narrow screens.
        const tables = document.querySelectorAll(".prose table");
        tables.forEach((table) => {
          if (table.parentElement?.classList.contains("overflow-x-auto")) return;
          const wrapper = document.createElement("div");
          wrapper.className =
            "overflow-x-auto w-full shadow-[8px_8px_0px_0px_#c6ff00] my-10";
          table.parentNode?.insertBefore(wrapper, table);
          wrapper.appendChild(table);
        });

        // Load YouTube only after an explicit user action.
        const ytPlaceholders = document.querySelectorAll(".youtube-defer");
        ytPlaceholders.forEach((container) => {
          const videoId = container.getAttribute("data-video") ?? "";

          // A YouTube video ID is exactly 11 URL-safe characters.
          if (!/^[A-Za-z0-9_-]{11}$/.test(videoId)) {
            container.remove();
            return;
          }

          container.className =
            "youtube-defer relative w-full aspect-video cursor-pointer border-4 border-white shadow-[8px_8px_0px_0px_#00e5ff] my-10 group overflow-hidden bg-black";
          container.setAttribute("role", "button");
          container.setAttribute("tabindex", "0");
          container.setAttribute(
            "aria-label",
            language === "id" ? "Putar video YouTube" : "Play YouTube video",
          );

          const img = document.createElement("img");
          img.src = `https://img.youtube.com/vi/${videoId}/hqdefault.jpg`;
          img.alt = language === "id"
            ? "Thumbnail video YouTube"
            : "YouTube video thumbnail";
          img.className =
            "w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity duration-300";

          const playBtnWrapper = document.createElement("div");
          playBtnWrapper.className =
            "absolute inset-0 flex items-center justify-center pointer-events-none";

          const playLabel = document.createElement("span");
          playLabel.className =
            "bg-[#c6ff00] text-black font-black px-6 py-3 border-4 border-white shadow-[4px_4px_0px_0px_#fff] text-lg md:text-xl transform group-hover:scale-105 transition-transform";
          playLabel.textContent = language === "id"
            ? "▶ TAMPILKAN VIDEO"
            : "▶ PLAY VIDEO";
          playBtnWrapper.appendChild(playLabel);

          container.replaceChildren(img, playBtnWrapper);

          const activateVideo = () => {
            const iframe = document.createElement("iframe");
            iframe.width = "100%";
            iframe.height = "100%";
            iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1`;
            iframe.title = language === "id"
              ? "Pemutar video YouTube"
              : "YouTube video player";
            iframe.setAttribute(
              "allow",
              "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share",
            );
            iframe.allowFullscreen = true;
            iframe.className = "absolute top-0 left-0 w-full h-full";

            container.className =
              "youtube-defer relative w-full aspect-video my-10 bg-black";
            container.removeAttribute("role");
            container.removeAttribute("tabindex");
            container.removeAttribute("aria-label");
            container.replaceChildren(iframe);
          };

          container.addEventListener("click", activateVideo);
          container.addEventListener("keydown", (event) => {
            if (event.key === "Enter" || event.key === " ") {
              event.preventDefault();
              activateVideo();
            }
          });
        });
      });
    </script>
  </body>
</html>
