---
// src/layouts/BlogLayout.astro
import SeoHead from "../components/SeoHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AuthorBox from "../components/article/AuthorBox.astro";
import Giscus from "../components/article/Giscus.astro";
import "@fontsource/inter/400.css";
import "@fontsource/inter/700.css";
import "@fontsource/inter/900.css";
import "@fontsource/fira-code/400.css";
import "@fontsource/fira-code/700.css";
import "../styles/global.css";

const { frontmatter, language } = Astro.props;
const homeUrl = language === "id" ? "/" : "/en/";
---

<html lang={language}>
  <head>
    <SeoHead
      title={frontmatter.title}
      description={frontmatter.description}
      image={frontmatter.coverImage}
      isArticle={true}
      language={language}
    />
  </head>
  <body
    class="overflow-x-hidden min-h-screen bg-neutral-900 text-white font-sans selection:bg-[#c6ff00] selection:text-black antialiased flex flex-col"
  >
    <Header currentLang={language} variant="article" />

    <main class="max-w-4xl mx-auto p-4 md:p-8 mt-8 flex-grow w-full">
      <article
        class="bg-neutral-800 border-4 border-white shadow-[12px_12px_0px_0px_#c6ff00] mb-12"
      >
        {
          frontmatter.coverImage && (
            <div class="border-b-4 border-white relative">
              <img
                src={frontmatter.coverImage}
                alt={`Ilustrasi: ${frontmatter.title}`}
                width="1200"
                height="630"
                loading="eager"
                fetchpriority="high"
                class="w-full max-h-[500px] object-cover object-center grayscale hover:grayscale-0 transition-all duration-500"
                onerror="this.removeAttribute('onerror'); this.setAttribute('src', 'https://placehold.co/1200x630/000000/c6ff00.png?text=Gambar+Tidak+Tersedia');"
              />
            </div>
          )
        }
        <div class="p-6 md:p-12">
          <header class="mb-10">
            <div class="flex flex-wrap gap-2 mb-6">
              {
                frontmatter.tags?.map((tag: string) => (
                  <span class="bg-[#c6ff00] text-black font-mono text-xs font-bold px-3 py-1 border-2 border-black uppercase">
                    {tag}
                  </span>
                ))
              }
            </div>

            <h1
              class="text-4xl md:text-5xl font-black tracking-tight mb-6 leading-tight"
            >
              {frontmatter.title}
            </h1>

            <div
              class="font-mono text-sm text-neutral-400 font-bold border-t-2 border-neutral-600 pt-4 flex flex-col md:flex-row justify-between gap-2"
            >
              <span>
                {language === "id" ? "Oleh" : "By"}
                <a
                  href={homeUrl}
                  class="text-white hover:text-[#c6ff00] underline underline-offset-4 decoration-2 ml-1"
                >
                  Herdi Herdianurdin
                </a>
              </span>
              <time datetime={frontmatter.pubDate.toISOString()}>
                {
                  new Date(frontmatter.pubDate).toLocaleDateString(
                    language === "id" ? "id-ID" : "en-US",
                    { year: "numeric", month: "long", day: "numeric" },
                  )
                }
              </time>
            </div>
          </header>

          <!-- 4. Area Konten Utama -->
          <div
            class="prose prose-invert prose-lg max-w-none prose-pre:border-4 prose-pre:border-white prose-pre:rounded-none prose-pre:shadow-[8px_8px_0px_0px_#00e5ff] prose-headings:font-black prose-a:text-[#c6ff00] prose-a:underline-offset-4 hover:prose-a:bg-[#c6ff00] hover:prose-a:text-black"
          >
            <slot />
          </div>

          <!-- 5. SEO Fix: Gunakan tag <footer> semantik untuk kotak penulis di dalam artikel -->
          <footer class="mt-16 pt-8 border-t-4 border-white">
            <AuthorBox language={language} />
          </footer>
        </div>
      </article>

      <!-- Ruang Diskusi di luar tag <article> karena ini adalah interaksi user, bukan isi jurnal inti -->
      <section class="mt-12">
        <Giscus language={language} />
      </section>
    </main>

    <Footer language={language} />
    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        // --- 1. PERBAIKAN TABEL MARKDOWN ---
        const tables = document.querySelectorAll(".prose table");
        tables.forEach((table) => {
          const wrapper = document.createElement("div");
          wrapper.className =
            "overflow-x-auto w-full shadow-[8px_8px_0px_0px_#c6ff00] my-10";
          table.parentNode.insertBefore(wrapper, table);
          wrapper.appendChild(table);
        });

        // --- 2. YOUTUBE LAZY LOAD (KLIK UNTUK MEMUAT) ---
        const ytPlaceholders = document.querySelectorAll(".youtube-defer");
        ytPlaceholders.forEach((container) => {
          const videoId = container.getAttribute("data-video");
          if (!videoId) return;

          // PERBAIKAN: Tambahkan kelas Tailwind agar kontainer memiliki rasio 16:9 (aspect-video)
          // dan berikan gaya Neo-Brutalism secara dinamis
          container.className =
            "youtube-defer relative w-full aspect-video cursor-pointer border-4 border-white shadow-[8px_8px_0px_0px_#00e5ff] my-10 group overflow-hidden bg-black";

          // Buat elemen gambar kelumit (thumbnail) dari YouTube
          const img = document.createElement("img");
          img.src = `https://img.youtube.com/vi/${videoId}/hqdefault.jpg`;
          img.alt = "Thumbnail Video";
          img.className =
            "w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity duration-300";

          // Buat tombol Putar bergaya Neo-Brutalism
          const playBtnWrapper = document.createElement("div");
          playBtnWrapper.className =
            "absolute inset-0 flex items-center justify-center pointer-events-none";
          playBtnWrapper.innerHTML = `<span class="bg-[#c6ff00] text-black font-black px-6 py-3 border-4 border-white shadow-[4px_4px_0px_0px_#fff] text-lg md:text-xl transform group-hover:scale-105 transition-transform">▶ TAMPILKAN VIDEO</span>`;

          container.appendChild(img);
          container.appendChild(playBtnWrapper);

          // Event saat pengguna mengeklik penampung
          container.addEventListener("click", () => {
            // Ganti isi div dengan iframe asli dan hapus border/shadow agar rapi saat diputar
            container.className =
              "youtube-defer relative w-full aspect-video my-10 bg-black";
            container.innerHTML = `<iframe width="100%" height="100%" src="https://www.youtube.com/embed/${videoId}?autoplay=1" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen class="absolute top-0 left-0 w-full h-full"></iframe>`;
          });
        });
      });
    </script>
  </body>
</html>
