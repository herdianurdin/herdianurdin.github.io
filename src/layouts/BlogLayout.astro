---
import { Image } from "astro:assets";
import SeoHead from "../components/SeoHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AuthorBox from "../components/article/AuthorBox.astro";
import Giscus from "../components/article/Giscus.astro";
import TableOfContents from "../components/article/TableOfContents.astro";
import RelatedArticles from "../components/article/RelatedArticles.astro";
import { siteConfig, siteTranslation } from "../config/site";
import "@fontsource/inter/400.css";
import "@fontsource/inter/700.css";
import "@fontsource/inter/900.css";
import "@fontsource/fira-code/400.css";
import "@fontsource/fira-code/700.css";
import "../styles/global.css";

const { frontmatter, headings, relatedPosts = [] } = Astro.props;
const language = Astro.props.language as keyof typeof siteTranslation;
const t = siteTranslation[language];
const profileUrl = language === "id" ? "/about/" : "/en/about/";
const defaultCoverImageAlt = language === "id"
  ? `Sampul artikel: ${frontmatter.title}`
  : `Article cover: ${frontmatter.title}`;
const journalUrl = language === "id" ? "/blog/" : "/en/blog/";
const translationHref = language === "id"
  ? (frontmatter.enSlug ? `/en/blog/${frontmatter.enSlug}/` : undefined)
  : (frontmatter.idSlug ? `/blog/${frontmatter.idSlug}/` : undefined);
---

<html lang={language}>
  <head>
    <SeoHead
      title={frontmatter.title}
      description={frontmatter.description}
      image={frontmatter.coverImage}
      imageAlt={frontmatter.coverImageAlt || frontmatter.title}
      isArticle={true}
      language={language}
      enSlug={frontmatter.enSlug}
      idSlug={frontmatter.idSlug}
      pubDate={frontmatter.pubDate}
      updatedDate={frontmatter.updatedDate}
    />
  </head>
  <body
    class="overflow-x-hidden min-h-screen bg-surface-page text-white font-sans selection:bg-brand-lime selection:text-black antialiased flex flex-col"
  >
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:border-4 focus:border-white focus:bg-brand-lime focus:px-4 focus:py-3 focus:font-mono focus:font-black focus:text-black focus:shadow-neo-ink-4"
    >
      {t.skipToContent}
    </a>
    <Header currentLang={language} variant="article" translationHref={translationHref} />

    <main id="main-content" tabindex="-1" class="site-container page-main page-main--article">
      <nav
        aria-label={language === "id" ? "Jejak navigasi" : "Breadcrumb"}
        class="mb-5 font-mono text-xs font-bold uppercase tracking-wide text-copy-muted"
      >
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href={journalUrl} class="underline decoration-2 underline-offset-4 transition-colors hover:text-brand-lime">{t.journalNav}</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="max-w-full text-white">{frontmatter.title}</li>
        </ol>
      </nav>

      <article
        class="mb-12 border-4 border-white bg-surface-panel shadow-neo-lime-8"
      >
        {
          frontmatter.coverImage && (
            <div class="border-b-4 border-white relative">
              {typeof frontmatter.coverImage === "string" ? (
                <img
                  src={frontmatter.coverImage}
                  alt={frontmatter.coverImageAlt || defaultCoverImageAlt}
                  width="1200"
                  height="630"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  class="aspect-[1200/630] w-full bg-surface-page object-cover object-center"
                />
              ) : (
                <Image
                  src={frontmatter.coverImage}
                  format="webp"
                  widths={[480, 800, 1200]}
                  sizes="(max-width: 768px) 100vw, 72rem"
                  quality={80}
                  alt={frontmatter.coverImageAlt || defaultCoverImageAlt}
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  class="aspect-[1200/630] w-full bg-surface-page object-cover object-center"
                />
              )}
            </div>
          )
        }
        <div class="p-5 md:p-10 lg:p-12">
          <div class="site-reading">
            <header class="mb-9">
              <p class="mb-4 font-mono text-xs font-black uppercase tracking-widest text-brand-cyan">
                {language === "id" ? "JURNAL TEKNOLOGI" : "TECHNOLOGY JOURNAL"}
              </p>
              <div class="mb-6 flex flex-wrap gap-2">
                {
                  frontmatter.tags?.map((tag: string) => (
                    <span class="border-2 border-black bg-brand-lime px-3 py-1 font-mono text-xs font-bold uppercase text-black">
                      {tag}
                    </span>
                  ))
                }
              </div>

              <h1 class="mb-4 text-4xl font-black leading-[1.08] tracking-tight text-white md:text-5xl">
                {frontmatter.title}
              </h1>

              <p class="mb-7 text-lg leading-relaxed text-neutral-300 md:text-xl">
                {frontmatter.description}
              </p>

              <div class="flex flex-col gap-3 border-t-2 border-border-muted pt-4 font-mono text-sm font-bold text-copy-muted sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-6">
                <span>
                  {t.writtenBy}
                  <a
                    href={profileUrl}
                    class="ml-1 text-white underline decoration-2 underline-offset-4 transition-colors hover:text-brand-lime"
                  >
                    {siteConfig.author}
                  </a>
                </span>
                <span class="flex flex-wrap items-center gap-1">
                  <span>{language === "id" ? "Diterbitkan" : "Published"}:</span>
                  <time datetime={frontmatter.pubDate.toISOString()}>
                    {new Date(frontmatter.pubDate).toLocaleDateString(
                      language === "id" ? "id-ID" : "en-US",
                      { year: "numeric", month: "long", day: "numeric" },
                    )}
                  </time>
                </span>
                {frontmatter.updatedDate && (
                  <span class="flex flex-wrap items-center gap-1">
                    <span>{language === "id" ? "Diperbarui" : "Updated"}:</span>
                    <time datetime={frontmatter.updatedDate.toISOString()}>
                      {new Date(frontmatter.updatedDate).toLocaleDateString(
                        language === "id" ? "id-ID" : "en-US",
                        { year: "numeric", month: "long", day: "numeric" },
                      )}
                    </time>
                  </span>
                )}
              </div>
            </header>

            <TableOfContents headings={headings} language={language} />

            <div class="prose prose-invert prose-lg max-w-none prose-headings:scroll-mt-28 prose-headings:font-black prose-headings:tracking-tight prose-a:text-brand-lime prose-a:underline-offset-4 hover:prose-a:bg-brand-lime hover:prose-a:text-black prose-pre:my-8 prose-pre:rounded-none prose-pre:border-4 prose-pre:border-white prose-pre:shadow-neo-cyan-6 prose-img:mx-auto prose-img:border-2 prose-img:border-white prose-img:shadow-neo-ink-2">
              <slot />
              {frontmatter.faq?.length > 0 && (
                <section class="mt-12" aria-labelledby="article-faq-heading">
                  <h2 id="article-faq-heading">
                    {language === "id" ? "Pertanyaan yang Sering Diajukan" : "Frequently Asked Questions"}
                  </h2>
                  {frontmatter.faq.map((item: { q: string; a: string }) => (
                    <div class="mb-8">
                      <h3>{item.q}</h3>
                      <p>{item.a}</p>
                    </div>
                  ))}
                </section>
              )}
            </div>
          </div>

          <footer class="mt-16 border-t-4 border-white pt-8">
            <AuthorBox language={language} />
          </footer>
        </div>
      </article>

      <RelatedArticles posts={relatedPosts} language={language} />

      <section class="mt-12">
        <Giscus language={language} />
      </section>
    </main>

    <Footer language={language} />
    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        // Load YouTube only after an explicit user action.
        const ytPlaceholders = document.querySelectorAll(".youtube-defer");
        ytPlaceholders.forEach((container) => {
          const videoId = container.getAttribute("data-video") ?? "";

          // A YouTube video ID is exactly 11 URL-safe characters.
          if (!/^[A-Za-z0-9_-]{11}$/.test(videoId)) {
            container.remove();
            return;
          }

          container.className =
            "youtube-defer relative w-full aspect-video cursor-pointer border-4 border-white shadow-neo-cyan-8 my-10 group overflow-hidden bg-surface-card";
          container.setAttribute("role", "button");
          container.setAttribute("tabindex", "0");
          container.setAttribute(
            "aria-label",
            language === "id" ? "Putar video YouTube" : "Play YouTube video",
          );

          const img = document.createElement("img");
          img.src = `https://img.youtube.com/vi/${videoId}/hqdefault.jpg`;
          img.alt = language === "id"
            ? "Thumbnail video YouTube"
            : "YouTube video thumbnail";
          img.className =
            "w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity duration-300";

          const playBtnWrapper = document.createElement("div");
          playBtnWrapper.className =
            "absolute inset-0 flex items-center justify-center pointer-events-none";

          const playLabel = document.createElement("span");
          playLabel.className =
            "bg-brand-lime text-black font-black px-6 py-3 border-4 border-white shadow-neo-paper-4 text-lg md:text-xl transform group-hover:scale-105 transition-transform";
          playLabel.textContent = language === "id"
            ? "▶ TAMPILKAN VIDEO"
            : "▶ PLAY VIDEO";
          playBtnWrapper.appendChild(playLabel);

          container.replaceChildren(img, playBtnWrapper);

          const activateVideo = () => {
            const iframe = document.createElement("iframe");
            iframe.width = "100%";
            iframe.height = "100%";
            iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1`;
            iframe.title = language === "id"
              ? "Pemutar video YouTube"
              : "YouTube video player";
            iframe.setAttribute(
              "allow",
              "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share",
            );
            iframe.allowFullscreen = true;
            iframe.className = "absolute top-0 left-0 w-full h-full";

            container.className =
              "youtube-defer relative w-full aspect-video my-10 bg-surface-card";
            container.removeAttribute("role");
            container.removeAttribute("tabindex");
            container.removeAttribute("aria-label");
            container.replaceChildren(iframe);
          };

          container.addEventListener("click", activateVideo);
          container.addEventListener("keydown", (event) => {
            if (event.key === "Enter" || event.key === " ") {
              event.preventDefault();
              activateVideo();
            }
          });
        });
      });
    </script>
  </body>
</html>
