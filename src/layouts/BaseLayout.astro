---
// src/layouts/BaseLayout.astro
import "@fontsource/inter/400.css";
import "@fontsource/inter/700.css";
import "@fontsource/inter/900.css";
import "@fontsource/fira-code/400.css";
import "@fontsource/fira-code/700.css";
import "../styles/global.css";

import SeoHead from "../components/SeoHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteTranslation } from "../config/site";

export interface Props {
  title: string;
  description: string;
  language: "id" | "en";
  headerVariant?: "home" | "page";
  noindex?: boolean;
}

const {
  title,
  description,
  language,
  headerVariant = "page",
  noindex = false,
} = Astro.props;
const t = siteTranslation[language];
---

<html lang={language}>
  <head>
    <SeoHead
      title={title}
      description={description}
      language={language}
      noindex={noindex}
    />
  </head>
  {
    (
      /* Tambahkan overflow-x-hidden di awal class */
      <body class="overflow-x-hidden min-h-screen bg-neutral-900 text-white font-sans selection:bg-brand-lime selection:text-black antialiased flex flex-col">
        <a
          href="#main-content"
          class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:border-4 focus:border-white focus:bg-brand-lime focus:px-4 focus:py-3 focus:font-mono focus:font-black focus:text-black focus:shadow-neo-ink-4"
        >
          {t.skipToContent}
        </a>
        <Header currentLang={language} variant={headerVariant} />
        {/* Slot adalah tempat di mana konten spesifik halaman akan disisipkan */}
        <slot />

        {/* Footer Standar */}
        <Footer language={language} />
      </body>
    )
  }
</html>
