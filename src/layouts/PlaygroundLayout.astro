---
import "@fontsource/inter/400.css";
import "@fontsource/inter/700.css";
import "@fontsource/inter/900.css";
import "@fontsource/fira-code/400.css";
import "@fontsource/fira-code/700.css";
import "../styles/global.css";

import SeoHead from "../components/SeoHead.astro";

export interface Props {
  title: string;
  description: string;
  language?: "id" | "en";
}

const { title, description, language = "id" } = Astro.props;
---

<html lang={language}>
  <head>
    <SeoHead
      title={title}
      description={description}
      language={language}
      languageAlternate={false}
    />
  </head>
  <body
    class="h-dvh w-full bg-neutral-900 text-white font-sans selection:bg-brand-lime selection:text-black antialiased flex flex-col overflow-x-hidden lg:overflow-hidden"
  >
    <a
      href="#playground-heading"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:border-4 focus:border-white focus:bg-brand-lime focus:px-4 focus:py-3 focus:font-mono focus:font-black focus:text-black focus:shadow-neo-ink-4"
    >
      {language === "id" ? "Lewati ke Playground" : "Skip to Playground"}
    </a>
    <main
      id="main-content"
      tabindex="-1"
      class="flex-1 flex flex-col w-full h-full relative overflow-y-auto lg:overflow-hidden"
    >
      <slot />
    </main>
  </body>
</html>
